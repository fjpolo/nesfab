/*
 * Procedural NES Game
 * A basic demo with procedural generation and player movement.
 */

chrrom ($0000)
    file(fmt, "assets/font.png")
chrrom ($1000)
    file(fmt, "assets/sprite.png")

// Game constants
ct U TILE_EMPTY = $00
ct U TILE_WALL  = $23 // '#' character in font
ct U TILE_PLAYER = $01

// Player state
struct Player
    U x
    U y
    U frame
    Bool facing_left

vars /game
    U frame_counter = 0
    Player p = Player(120, 120, 0, false)
    U seed_val = 0

// NMI
nmi game_nmi()
    frame_counter = frame_counter + 1
    
    // Upload palette if needed (we'll just do it once at start)
    // ppu_upload_palette()
    
    // Set scroll
    {PPUSCROLL}(0)
    {PPUSCROLL}(0)
    {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
    
    // Update OAM and poll pads
    ppu_upload_oam_poll_pads(0)

// Function to get tile at X, Y (simplified)
fn get_tile(U x, U y) U
    // This would normally read from VRAM or a buffer.
    // For now, we'll just return a value based on a simple formula.
    return TILE_EMPTY

// MAIN
mode main()  
    mmc3_reset()
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)    
    
    // Set a vibrant palette
    palette[PALETTE_UBC] = $0F // Black background
    
    // BG Palettes
    palette[0] = $00
    palette[1] = $10
    palette[2] = $30
    palette[3] = $01
    palette[4] = $11
    palette[5] = $21
    palette[6] = $06
    palette[7] = $16
    palette[8] = $26

    
    palette[12] = $15
    palette[13] = $27
    palette[14] = $30
    
    ppu_upload_palette()
    
    // Procedural Screen Generation
    ppu_set_addr($2000)
    seed(frame_counter) // Use frame counter as seed
    
    for U y = 0; y < 30; y += 1
        for U x = 0; x < 32; x += 1
            U tile = TILE_EMPTY
            if y == 0 || y == 29 || x == 0 || x == 31
                tile = TILE_WALL
            else if (rand() & $1F) == 0
                tile = TILE_WALL
                
            {PPUDATA}(tile)
            
    // Draw Title
    ppu_set_addr($2042)
    {PPUDATA}($10) // 'P' (approximate)
    {PPUDATA}($12) // 'R'
    {PPUDATA}($0F) // 'O'
    {PPUDATA}($03) // 'C'
    {PPUDATA}($05) // 'E'
    {PPUDATA}($04) // 'D'
    {PPUDATA}($15) // 'U'
    {PPUDATA}($12) // 'R'
    {PPUDATA}($01) // 'A'
    {PPUDATA}($0C) // 'L'
    
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)

    while true
        nmi
        update_pads()
        
        // Input Handling
        U old_x = p.x
        U old_y = p.y
        
        if pads[0].held & BUTTON_LEFT
            p.x -= 1
            p.facing_left = true
        if pads[0].held & BUTTON_RIGHT
            p.x += 1
            p.facing_left = false
        if pads[0].held & BUTTON_UP
            p.y -= 1
        if pads[0].held & BUTTON_DOWN
            p.y += 1
            
        // Simple bounds check
        if p.x < 8 || p.x > 240 || p.y < 8 || p.y > 224
            p.x = old_x
            p.y = old_y

        // Animation
        if (frame_counter & 7) == 0
            p.frame = (p.frame + 1) & 3

        // Sprite Rendering
        U attr = 0
        if p.facing_left
            attr |= ATTR_H_FLIP
            
        // Draw a 2x2 player sprite (16x16 pixels)
        set_oam(0, p.x,     p.y,     $00, attr)
        set_oam(4, p.x + 8, p.y,     $01, attr)
        set_oam(8, p.x,     p.y + 8, $10, attr)
        set_oam(12, p.x + 8, p.y + 8, $11, attr)
        
        hide_oam(16)
        
        // Procedural "living" tiles: change one random tile every frame
        if (frame_counter & 7) == 0
            U rx = (rand() & 30) + 1
            U ry = (rand() & 28) + 1
            ppu_set_addr($2000 + (UU(ry) << 5) + UU(rx))
            {PPUDATA}(U(rand() & $3F))
