#:name:# 
#:path:# 

// Since this example uses CNROM, we'll store each CHR file at a different offset.
// Note that you don't have to use "path"; you could use "name" to derive a filename instead.

ct U chr_#name#_index = _index

data /chr_data
    [] chr_#name#_data
        file(fmt, #"path"#)
        file(fmt, "assets/sprite.png")

