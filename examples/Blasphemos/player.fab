/*
 * BlasNESmous - The Penitent One
 * Based on LuciYFer engine
 */

// Player movements
ct Int PLAYER_MOVING_REST = 0
ct Int PLAYER_MOVING_RIGHT = 1
ct Int PLAYER_MOVING_LEFT = 2
ct Int PLAYER_MOVING_JUMP = 3
ct Int PLAYER_MOVING_ATTACK = 4
ct Int PLAYER_MOVING_CLIMB = 5
ct Int PLAYER_MOVING_HURT = 6
ct Int PLAYER_MOVING_DASH = 7
ct Int PLAYER_MOVING_PARRY = 8
ct Int PLAYER_MOVING_LEDGE = 9

ct Int DASH_SPEED = 4
ct Int DASH_DURATION = 15
ct Int DASH_COOLDOWN = 60

ct Int PARRY_DURATION = 60
ct Int PARRY_COOLDOWN = 120

ct U ATTACK_NORMAL = 0
ct U ATTACK_BOSS = 1
ct U ATTACK_PILGRIM = 2


// Player speeds
ct Int PLAYER_SPEED_WALK = 1
ct Int PLAYER_SPEED_CLIMB = 1
ct Int PLAYER_SPEED_RUN = 2
ct Int JUMP_SPEED = -4

// Player initial [x, y]
ct Int PLAYER_INITIAL_X = 16
ct Int PLAYER_INITIAL_Y = 160

// Player width and height (32x32 metasprite)
ct Int pw = 16 // Collision width (tighter than visual)
ct Int ph = 30 // Collision height
ct Int rw = pw - 1
ct Int rh = ph - 1

ct Int PLAYER_INITIAL_ATTACK_POWER = 8
ct Int PLAYER_PARRY_BOSS_PUSH = 24

ct Int PLAYER_MAX_HEALTH = 50
ct Int PLAYER_STARTING_BILE_VESSELS = 1
ct Int PLATFORM_OFFSET = 13 // Pixels from top of tile to platform surface

// Player data struct
struct Player
    SS x
    SSF y
    SS w
    SS h
    SS rw
    SS rh
    SS center_x 
    SS center_y
    SS hitbox_x
    SS hitbox_center_x
    SF xspeed
    SF yspeed
    U movement
    AnimState anim_state
    U level_index
    Bool is_initialised
    SS camera_x
    U health
    U attack_timer
    U hurt_timer
    Bool facing_left
    U attack_power
    U dash_timer
    U dash_cooldown
    U last_input_timer
    U last_input_dir
    U parry_timer
    U parry_cooldown
    Bool buffered_attack
    Bool is_invincible
    U pogo_count
    U max_bile_vessels
    U current_bile_vessels
    U heal_timer

vars /game
    Bool player_sword_active = false
    SS player_sword_x = 0
    SS player_sword_y = 0
    SS player_sword_w = 16
    SS player_sword_h = 29

// Sprites and animations
data /sprites
    // THE PENITENT ONE metasprites (32x32)
    // Standing: x=0..31, y=0..31 (Primary) and x=32..63, y=0..31 (Secondary)
