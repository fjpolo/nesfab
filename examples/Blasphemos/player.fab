/*
 * BlasNESmous - The Penitent One
 * Based on LuciYFer engine
 */

// Player movements
ct Int PLAYER_MOVING_REST = 0
ct Int PLAYER_MOVING_RIGHT = 1
ct Int PLAYER_MOVING_LEFT = 2
ct Int PLAYER_MOVING_JUMP = 3
ct Int PLAYER_MOVING_ATTACK = 4
ct Int PLAYER_MOVING_CLIMB = 5
ct Int PLAYER_MOVING_HURT = 6
ct Int PLAYER_MOVING_DASH = 7

ct Int DASH_SPEED = 4
ct Int DASH_DURATION = 15
ct Int DASH_COOLDOWN = 60


// Player speeds
ct Int PLAYER_SPEED_WALK = 1
ct Int PLAYER_SPEED_CLIMB = 1
ct Int PLAYER_SPEED_RUN = 2
ct Int JUMP_SPEED = -4

// Player initial [x, y]
ct Int PLAYER_INITIAL_X = 32
ct Int PLAYER_INITIAL_Y = 160

// Player width and height (32x32 metasprite)
ct Int pw = 16 // Collision width (tighter than visual)
ct Int ph = 30 // Collision height
ct Int rw = pw - 1
ct Int rh = ph - 1

ct Int PLAYER_INITIAL_ATTACK_POWER = 7

// Player data struct
struct Player
    SS x
    SSF y
    SS w
    SS h
    SS rw
    SS rh
    SS center_x 
    SS center_y
    SF xspeed
    SF yspeed
    U movement
    AnimState anim_state
    U level_index
    Bool is_initialised
    SS camera_x
    U health
    U attack_timer
    U hurt_timer
    Bool facing_left
    U attack_power
    U dash_timer
    U dash_cooldown
    U last_input_timer
    U last_input_dir

vars /game
    Bool player_sword_active = false
    SS player_sword_x = 0
    SS player_sword_y = 0
    SS player_sword_w = 24
    SS player_sword_h = 24

// Sprites and animations
data /sprites
    // THE PENITENT ONE metasprites (32x32)
    // Standing: x=0..31, y=0..31 (Primary) and x=32..63, y=0..31 (Secondary)
