    [] penitent_animation_standing
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_standing_right)
        )))
    
    [] penitent_animation_standing_left
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_standing_left)
        )))

    [] penitent_animation_parry_right
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_parry_right)
        )))

    [] penitent_animation_parry_left
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_parry_left)
        )))

    [] penitent_animation_jump
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_jump_right)
        )))
    
    [] penitent_animation_jump_left
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_jump_left)
        )))

    [] penitent_animation_attack
        (make_anim(Fs{}(
            Fs(5, @sprite_penitent_attack_right_01),
            Fs(5, @sprite_penitent_attack_right_02),
            Fs(5, @sprite_penitent_attack_right_03)
        )))

    [] penitent_animation_attack_left
        (make_anim(Fs{}(
            Fs(5, @sprite_penitent_attack_left_01),
            Fs(5, @sprite_penitent_attack_left_02),
            Fs(5, @sprite_penitent_attack_left_03)
        )))

    [] penitent_animation_hit
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_hit_right)
        )))
    
    [] penitent_animation_hit_left
        (make_anim(Fs{}(
            Fs(1,  @sprite_penitent_hit_left)
        )))

    [] penitent_animation_walk
        (make_anim(Fs{}(
            Fs(5,  @sprite_penitent_walk_right_01),
            Fs(5,  @sprite_penitent_walk_right_02),
            Fs(5,  @sprite_penitent_walk_right_03),
            Fs(5,  @sprite_penitent_walk_right_02),
        )))

    [] penitent_animation_walk_left
        (make_anim(Fs{}(
            Fs(5,  @sprite_penitent_walk_left_01),
            Fs(5,  @sprite_penitent_walk_left_02),
            Fs(5,  @sprite_penitent_walk_left_03),
            Fs(5,  @sprite_penitent_walk_left_02)
        )))

    [] penitent_animation_dash
        (make_anim(Fs{}(
            Fs(1, @sprite_penitent_walk_right_01)
        )))

    [] penitent_animation_dash_left
        (make_anim(Fs{}(
            Fs(1, @sprite_penitent_walk_left_01)
        )))

fn push_oam_anim_palette(U index, SS x, SS y, AnimState anim_state, U palette_target, U attr_xor) U
    anim_state.frames += U(2 + (anim_state.frame_index * sizeof Fs))
    CCC/sprites metasprite = read CCC/sprites(anim_state.frames)
    
    U size = metasprite[0]
    do for U i = 0; i != size;
        i += 1
        U oy = metasprite[i]
        i += 1
        U pattern = metasprite[i]
        i += 1
        U attr = metasprite[i]
        i += 1
        U ox = metasprite[i]
        
        if (attr & 3) == palette_target
            SS sprite_x = x + SS(S(ox))
            if sprite_x.b == 0
                SS sprite_y = y + SS(S(oy))
                if sprite_y.b == 0 && sprite_y.a <= 240
                    set_oam_p(index, pattern)
                    set_oam_a(index, attr ^ attr_xor)
                    set_oam_y(index, sprite_y.a)
                    set_oam_x(index, sprite_x.a)
                    index += 4
    return U(index)
    
fn player_pogo()
    if p.pogo_count < 2 && !is_on_ground()
        p.yspeed = -3.0
        p.pogo_count += 1


fn player_respawn()
    if prie_dieu_lit
        logf(@"Respawning at Prie Dieu (Level %d)"l, last_prie_dieu_level)
        current_level_index = last_prie_dieu_level
        p.level_index = current_level_index
        p.x = last_prie_dieu_x
        p.y = SSF(last_prie_dieu_y)
        p.health = U(PLAYER_MAX_HEALTH)
        p.hurt_timer = 0
        p.movement = PLAYER_MOVING_REST
        p.anim_state = make_anim_state(@penitent_animation_standing)
        p.camera_x = max(0, p.x - 128)
    else
        logf(@"No Prie Dieu active. Respawning at Level %d start."l, current_level_index)
        p.health = U(PLAYER_MAX_HEALTH)
        p.hurt_timer = 0
        p.movement = PLAYER_MOVING_REST
        p.x = PLAYER_INITIAL_X
        p.y = SSF(PLAYER_INITIAL_Y)
        p.camera_x = 0
    
    for U i = 0; i < 16; i += 1
        dead_pilgrims[i] = 0
        dead_wheelbrokens[i] = 0
        dead_eyes[i] = 0
        dead_following_eyes[i] = 0

    p.current_bile_vessels = p.max_bile_vessels

    p.is_initialised = true
    p.level_index = current_level_index
    goto mode play_level(current_level_index)
    : preserves /game

fn make_player_penitent() Player
    Player p = Player()
    p.x = PLAYER_INITIAL_X
    p.y = SSF(PLAYER_INITIAL_Y)
    p.w = pw
    p.h = ph
    p.rw = rw
    p.rh = rh
    p.movement = PLAYER_MOVING_REST
    p.anim_state = make_anim_state(@penitent_animation_standing)
    p.level_index = FIRST_LEVEL_INDEX
    p.is_initialised = true
    if game_mode == GAME_MODE_KONAMI
        p.health = 50
    else
        p.health = U(PLAYER_MAX_HEALTH)
    p.attack_timer = 0
    p.hurt_timer = 0
    p.facing_left = false
    p.dash_timer = 0
    p.dash_cooldown = 0
    p.last_input_timer = 0
    p.last_input_dir = 0
    p.parry_timer = 0
    p.parry_cooldown = 0
    p.buffered_attack = false
    p.attack_power = PLAYER_INITIAL_ATTACK_POWER
    p.max_bile_vessels = 1
    p.current_bile_vessels = 1
    p.heal_timer = 0
    return p

fn update_player()
    if !p.is_initialised
        p = make_player_penitent()
    
    p.attack_power = PLAYER_INITIAL_ATTACK_POWER

    p.center_x = p.x + (p.w >> 1)
    p.center_y = SS(p.y) + (p.h >> 1)

    if p.facing_left
        p.hitbox_x = p.x - 16
    else
        p.hitbox_x = p.x
    p.hitbox_center_x = p.hitbox_x + (p.w >> 1)

    if p.heal_timer > 0
        p.heal_timer -= 1
    
    handle_input()
    handle_physics()
    handle_collisions()
    update_camera()

    // Update sword hitbox
    if p.movement == PLAYER_MOVING_ATTACK
        player_sword_active = true
        player_sword_y = SS(p.y) - 2
        if p.facing_left
            player_sword_x = p.hitbox_center_x - 32
        else
            player_sword_x = p.hitbox_center_x + 8
            



        // --- WARDEN BOSS HITBOX TEST ---
        if warden_active && warden_hurt_timer == 0
            if player_sword_x < (warden_x + warden_w) && (player_sword_x + player_sword_w) > warden_x
                if player_sword_y < (warden_y + warden_h) && (player_sword_y + player_sword_h) > warden_y
                    if warden_health > p.attack_power
                        warden_health -= p.attack_power
                    else
                        warden_health = 0
                    warden_hurt_timer = 30 // IFrames
                    player_pogo()
                    logf(@"Warden HP: %d"l, warden_health)
                    if warden_health == 0
                        warden_state = WARDEN_STATE_DEAD
                        warden_defeated = true
                        for U i = 0; i < 3; i += 1
                            warden_projectile_active[i] = false
                        // warden_active stays true so we can still see/tint him
    else
        player_sword_active = false

    // Victory transition: If warden is dead and player passes through him
    if warden_active && warden_state == WARDEN_STATE_DEAD
        if p.x > (warden_x + (warden_w >> 1))
            current_level_index = 1
            p.level_index = current_level_index
            warden_active = false
            warden_state = WARDEN_STATE_IDLE
            p.x = PLAYER_INITIAL_X
            p.y = SSF(PLAYER_INITIAL_Y)
            goto mode play_level(current_level_index)
            : preserves /game

    // Update dash timers
    if p.dash_timer > 0
        p.dash_timer -= 1
        if p.dash_timer == 0
            p.dash_cooldown = DASH_COOLDOWN
            if p.buffered_attack
                p.buffered_attack = false
                p.attack_timer = 20
                p.movement = PLAYER_MOVING_ATTACK
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_attack_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_attack)
            else
                p.movement = PLAYER_MOVING_REST
    
    if p.dash_cooldown > 0
        p.dash_cooldown -= 1
        
    if p.parry_timer > 0
        p.parry_timer -= 1
        if p.parry_timer == 0
            if p.movement == PLAYER_MOVING_PARRY
                p.movement = PLAYER_MOVING_REST
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_standing_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_standing)
            p.parry_cooldown = PARRY_COOLDOWN
    
    if p.parry_cooldown > 0
        p.parry_cooldown -= 1

    if p.last_input_timer > 0
        p.last_input_timer -= 1

fn handle_input()
    if p.movement == PLAYER_MOVING_LEDGE
        if pads[0].pressed & BUTTON_A
            p.yspeed = JUMP_SPEED
            p.movement = PLAYER_MOVING_JUMP
            if p.facing_left
                p.anim_state = make_anim_state(@penitent_animation_jump_left)
            else
                p.anim_state = make_anim_state(@penitent_animation_jump)
            return
        if pads[0].held & BUTTON_DOWN
            p.movement = PLAYER_MOVING_JUMP
            return
        return

    // Handle hurt timer
    if p.hurt_timer > 0
        p.hurt_timer -= 1
        if p.hurt_timer == 105 // End of 15-frame recoil
            if p.movement == PLAYER_MOVING_HURT
                p.movement = PLAYER_MOVING_REST
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_standing_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_standing)
        
        if p.hurt_timer > 105
            return // Prevent input ONLY during hit recoil (first 15 frames)

    // Handle attack timer
    if p.attack_timer > 0
        p.attack_timer -= 1
        if p.attack_timer == 0
            if p.movement == PLAYER_MOVING_ATTACK
                p.movement = PLAYER_MOVING_REST
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_standing_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_standing)
        return // Prevent other input during attack
    
    // Prevent input during dash or parry
    if p.dash_timer > 0
        if pads[0].pressed & BUTTON_B
            p.buffered_attack = true
        return

    if p.parry_timer > 0
        return

    if (pads[0].pressed & BUTTON_UP) && (pads[0].held & BUTTON_SELECT)
        p.is_invincible = !p.is_invincible
        cheat_shake_timer = 20

    // Parry activation
    if (pads[0].pressed & BUTTON_UP) && p.parry_cooldown == 0 && is_on_ground()
        p.movement = PLAYER_MOVING_PARRY
        p.parry_timer = PARRY_DURATION
        if p.facing_left
            p.anim_state = make_anim_state(@penitent_animation_parry_left)
        else
            p.anim_state = make_anim_state(@penitent_animation_parry_right)
        return

    // Double tap detection
    if pads[0].pressed & BUTTON_LEFT
        if p.last_input_timer > 0 && p.last_input_dir == BUTTON_LEFT && p.dash_cooldown == 0 && is_on_ground()
            p.movement = PLAYER_MOVING_DASH
            p.dash_timer = DASH_DURATION
            p.facing_left = true
            p.anim_state = make_anim_state(@penitent_animation_dash_left)
            return
        p.last_input_timer = 15 // Window for double tap
        p.last_input_dir = BUTTON_LEFT
        
    if pads[0].pressed & BUTTON_RIGHT
        if p.last_input_timer > 0 && p.last_input_dir == BUTTON_RIGHT && p.dash_cooldown == 0 && is_on_ground()
            p.movement = PLAYER_MOVING_DASH
            p.dash_timer = DASH_DURATION
            p.facing_left = false
            p.anim_state = make_anim_state(@penitent_animation_dash)
            return
        p.last_input_timer = 15
        p.last_input_dir = BUTTON_RIGHT

    // Bile Vessel consumption
    if pads[0].pressed & BUTTON_DOWN
        if p.last_input_timer > 0 && p.last_input_dir == BUTTON_DOWN
            if p.current_bile_vessels > 0
                p.current_bile_vessels -= 1
                p.health += bile_vessel_hp
                p.heal_timer = 30
                if p.health > U(PLAYER_MAX_HEALTH)
                    p.health = U(PLAYER_MAX_HEALTH)
        p.last_input_timer = 15
        p.last_input_dir = BUTTON_DOWN

    SS speed = PLAYER_SPEED_WALK
    if pads[0].held & BUTTON_SELECT
        speed = PLAYER_SPEED_RUN

    Bool climbing = false
    if collision_at(UU(p.center_x), UU(p.center_y)) == C_LADDER
        if pads[0].held & BUTTON_UP
            p.y -= SSF(PLAYER_SPEED_CLIMB)
            climbing = true
        else if (pads[0].held & BUTTON_DOWN) && !is_on_ground()
            p.y += SSF(PLAYER_SPEED_CLIMB)
            climbing = true

        if climbing || p.movement == PLAYER_MOVING_CLIMB
            if p.movement != PLAYER_MOVING_CLIMB
                p.movement = PLAYER_MOVING_CLIMB
                p.yspeed = 0
                p.anim_state = make_anim_state(@penitent_animation_standing)
            
            if pads[0].pressed & BUTTON_A
                p.movement = PLAYER_MOVING_JUMP
                p.yspeed = JUMP_SPEED
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_jump_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_jump)
            else if pads[0].pressed & BUTTON_B
                p.movement = PLAYER_MOVING_JUMP
                p.yspeed = 0
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_jump_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_jump)
                return
    else
        if p.movement == PLAYER_MOVING_CLIMB
            p.movement = PLAYER_MOVING_JUMP
            p.yspeed = 0
            if p.facing_left
                p.anim_state = make_anim_state(@penitent_animation_jump_left)
            else
                p.anim_state = make_anim_state(@penitent_animation_jump)

    if pads[0].held & BUTTON_LEFT
        p.x -= speed
        if !p.facing_left || p.movement != PLAYER_MOVING_LEFT
            p.facing_left = true
            if p.movement != PLAYER_MOVING_CLIMB
                p.movement = PLAYER_MOVING_LEFT
                p.anim_state = make_anim_state(@penitent_animation_walk_left)
    else if pads[0].held & BUTTON_RIGHT
        p.x += speed
        if p.facing_left || p.movement != PLAYER_MOVING_RIGHT
            p.facing_left = false
            if p.movement != PLAYER_MOVING_CLIMB
                p.movement = PLAYER_MOVING_RIGHT
                p.anim_state = make_anim_state(@penitent_animation_walk)
    else
        // Not moving horizontally
        if p.movement != PLAYER_MOVING_REST
            if p.movement != PLAYER_MOVING_CLIMB
                p.movement = PLAYER_MOVING_REST
                if p.facing_left
                    p.anim_state = make_anim_state(@penitent_animation_standing_left)
                else
                    p.anim_state = make_anim_state(@penitent_animation_standing)
    
    // Jump
    if pads[0].pressed & BUTTON_A
        if is_on_ground()
            p.yspeed = JUMP_SPEED

    // Attack
    if pads[0].pressed & BUTTON_B
        p.attack_timer = 20
        p.movement = PLAYER_MOVING_ATTACK
        if p.facing_left
            p.anim_state = make_anim_state(@penitent_animation_attack_left)
        else
            p.anim_state = make_anim_state(@penitent_animation_attack)
        return
    // Switch to jump animation if airborne (priority over walking/rest)
    if !is_on_ground() && p.movement != PLAYER_MOVING_CLIMB
        if p.movement != PLAYER_MOVING_JUMP
            p.movement = PLAYER_MOVING_JUMP
            if p.facing_left
                p.anim_state = make_anim_state(@penitent_animation_jump_left)
            else
                p.anim_state = make_anim_state(@penitent_animation_jump)

fn is_on_ground() Bool
    UU y = UU(SS(p.y) + p.h)
    UU x1 = UU(p.x)
    UU x2 = UU(p.x + p.rw)
    
    U t1 = collision_at(x1, y)
    U t2 = collision_at(x2, y)
    
    if t1 == C_WALL || t2 == C_WALL
        return true
        
    if t1 == C_PLATFORM || t2 == C_PLATFORM
        // Land on platform if moving down, were previously above its surface, 
        // and are currently within the 3-pixel landing window.
        if p.yspeed >= 0
            SS surface_y = SS(y & $F0) + PLATFORM_OFFSET
            SS old_y_feet = SS(p.y - SSF(p.yspeed)) + p.h
            if old_y_feet <= surface_y && (SS(p.y) + p.h) <= surface_y + 3
                return true
    
    return false

fn handle_physics()
    if p.movement == PLAYER_MOVING_DASH
        if p.facing_left
            p.x -= DASH_SPEED
        else
            p.x += DASH_SPEED
        return

    if p.movement == PLAYER_MOVING_LEDGE
        p.yspeed = 0
        return

    if p.movement == PLAYER_MOVING_CLIMB
        p.yspeed = 0
    else
        p.y += SSF(p.yspeed)
        
        // Ledge detection
        if p.movement == PLAYER_MOVING_JUMP && p.yspeed >= 0
            SS lx = p.center_x
            if p.facing_left
                lx -= 10
            else
                lx += 10
            SS ly = SS(p.y) + 8
            U t = collision_at(UU(lx), UU(ly))
            if (t == C_WALL || t == C_PLATFORM) && ((p.facing_left && (pads[0].held & BUTTON_LEFT)) || (!p.facing_left && (pads[0].held & BUTTON_RIGHT)))
                if collision_at(UU(lx), UU(ly - 16)) == C_OPEN
                    p.movement = PLAYER_MOVING_LEDGE
                    p.yspeed = 0
                    p.y = SSF(ly & $F0) - SSF(8)
                    return
        
        if is_on_ground()
            p.pogo_count = 0
            if p.yspeed > 0
                p.yspeed = 0
                
                UU feet_y = UU(SS(p.y) + p.h)
                U t1 = collision_at(UU(p.x), feet_y)
                U t2 = collision_at(UU(p.x + p.rw), feet_y)
                
                SS snap_y = SS(feet_y & $F0)
                if t1 == C_PLATFORM || t2 == C_PLATFORM
                    snap_y += PLATFORM_OFFSET
                
                p.y = SSF(snap_y) - SSF(p.h)
        else
            p.yspeed += 0.25
            if p.yspeed > 4
                p.yspeed = 4
        
        // Out of bounds check
        if SS(p.y) > (SS(current_level_height) << 4)
            p.health = 0
            player_respawn()

fn player_prepare_level_transition()
    p.movement = PLAYER_MOVING_REST
    p.anim_state = make_anim_state(@penitent_animation_standing)
    p.attack_timer = 0
    p.hurt_timer = 0
    p.dash_timer = 0
    p.dash_cooldown = 0
    p.parry_timer = 0
    p.parry_cooldown = 0
    p.buffered_attack = false
    p.is_initialised = true

fn handle_collisions()
    if collision_at(UU(p.center_x), UU(p.center_y)) == C_EXIT
        current_level_index += 1
        p.level_index = current_level_index
        player_prepare_level_transition()
        p.x = PLAYER_INITIAL_X
        p.y = SSF(PLAYER_INITIAL_Y)
        p.camera_x = 0
        goto mode play_level(current_level_index)
        : preserves /game
    
    // Level 0 -> Level 1 transition via right bound
    SS level_right_bound = (SS(current_level_width) << 4) - 20
    if p.x > level_right_bound && current_level_index == 0
        current_level_index = 1
        p.level_index = current_level_index
        player_prepare_level_transition()
        p.camera_x = 0
        p.x = 16 // Reset to left side of next level
        p.y = SSF(PLAYER_INITIAL_Y)
        goto mode play_level(current_level_index)
        : preserves /game
    
    // Level 1 -> Level 2 transition via right bound
    else if p.x > level_right_bound && current_level_index == 1
        current_level_index = 2
        p.level_index = current_level_index
        player_prepare_level_transition()
        p.camera_x = 0
        p.x = 16 // Reset to left side of next level
        p.y = SSF(PLAYER_INITIAL_Y)
        goto mode play_level(current_level_index)
        : preserves /game
    else if p.x > level_right_bound && current_level_index == 2
        current_level_index = 3
        p.level_index = current_level_index
        player_prepare_level_transition()
        p.camera_x = 0
        p.x = 16 // Reset to left side of next level
        p.y = SSF(PLAYER_INITIAL_Y)
        goto mode play_level(current_level_index)
        : preserves /game
    else if p.x < 0 && current_level_index == 2
        current_level_index = 1
        p.level_index = current_level_index
        player_prepare_level_transition()
        spawn_from_right = true
        p.y = SSF(PLAYER_INITIAL_Y)
        goto mode play_level(current_level_index)
        : preserves /game
    else if p.x < 0 && current_level_index == 3
        current_level_index = 2
        p.level_index = current_level_index
        player_prepare_level_transition()
        spawn_from_right = true
        p.y = SSF(PLAYER_INITIAL_Y)
        goto mode play_level(current_level_index)
        : preserves /game

fn update_camera()
    ct Int window = 112
    if p.center_x - p.camera_x < window
        p.camera_x = p.center_x - window
    else if p.center_x - p.camera_x > 256 - window
        p.camera_x = p.center_x - (256 - window)
    p.camera_x = min(max(0, p.camera_x), (SS(current_level_width) << 4) - 256)

fn restore_player(Player a) Player
    return a

fn save_player(Player a) Player
    return a

fn hurt_player(U attack_type, SS ex) Bool
    if p.is_invincible
        return true

    if p.parry_timer > 0 || p.movement == PLAYER_MOVING_PARRY
        // Only parry if facing the enemy
        if (p.facing_left && ex < p.hitbox_center_x) || (!p.facing_left && ex > p.hitbox_center_x)
            if attack_type == ATTACK_BOSS
                if p.facing_left
                    p.x += PLAYER_PARRY_BOSS_PUSH
                else
                    p.x -= PLAYER_PARRY_BOSS_PUSH
            return true // Signal that a parry occurred
    
    // If not parrying (or facing the wrong way), check for damage
    if p.hurt_timer == 0
        U damage = 3
        if attack_type == ATTACK_BOSS
            damage = 10
        else if attack_type == ATTACK_PILGRIM
            damage = 13
        
        // Final safety check: never damage if parrying
        if p.parry_timer > 0 || p.movement == PLAYER_MOVING_PARRY
            return true

        if p.health > damage
            p.health -= damage
        else
            p.health = 0
        p.hurt_timer = 120 // 2 seconds of immunity
        p.dash_timer = 0
        p.attack_timer = 0
        p.buffered_attack = false
        p.movement = PLAYER_MOVING_HURT
        if p.facing_left
            p.anim_state = make_anim_state(@penitent_animation_hit_left)
        else
            p.anim_state = make_anim_state(@penitent_animation_hit)
        
        if p.health == 0
            player_respawn()
        
        return false // Damage taken, not parried
    
    return false // I-frames active, not parried

