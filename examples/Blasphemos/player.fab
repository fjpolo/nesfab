        (make_metasprite(0, Ms{}(
            // Primary tiles (Palette 0)
            Ms(0,-32, $01, $00),
            Ms(-8,-24, $10, $00), Ms(0,-24, $11, $00), Ms( 8,-24, $12, $00),
            Ms(-8,-16, $20, $00), Ms(0,-16, $21, $00), Ms( 8,-16, $22, $00),
