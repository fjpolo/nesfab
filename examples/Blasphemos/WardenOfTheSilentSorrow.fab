/*
 * BlasNESmous - Warden of the Silent Sorrow
 * Boss Logic
 */

data /sprites
    // Ammunition
    [] sprite_projectile_ball
        (make_metasprite(0, Ms{}(
            Ms( 0,-8, $9D, $03),    // Top left
            Ms( 0, 0, $9D, $83),    // Bottom left
            Ms( 8,-8, $9D, $43),    // Top right
            Ms( 8, 0, $9D, $C3)     // Bottom right
        )))

    [] projectile_animation_ball
        (make_anim(Fs{}(
            Fs(1, @sprite_projectile_ball)
        )))

    [] sprite_projectile_ball_grounded
        (make_metasprite(0, Ms{}(
            Ms( 0,-8, $9D, $23),    // Top left (Back layer: $03 | $20)
            Ms( 0, 0, $9D, $A3),    // Bottom left (Back layer: $83 | $20)
            Ms( 8,-8, $9D, $63),    // Top right (Back layer: $43 | $20)
            Ms( 8, 0, $9D, $E3)     // Bottom right (Back layer: $C3 | $20)
        )))

    [] projectile_animation_ball_grounded
        (make_anim(Fs{}(
            Fs(1, @sprite_projectile_ball_grounded)
        )))

    [] sprite_warden_spike
        (make_metasprite(0, Ms{}(
            Ms( 0,-16, $AC, $03) // Single tile spike, shifted up to be visible
        )))

    [] projectile_animation_spike
        (make_anim(Fs{}(
            Fs(1, @sprite_warden_spike)
        )))

    // Enraged variants (Palette 0 - Red)
    [] sprite_projectile_ball_red
        (make_metasprite(0, Ms{}(
            Ms( 0,-8, $9D, $00),
            Ms( 0, 0, $9D, $80),
            Ms( 8,-8, $9D, $40),
            Ms( 8, 0, $9D, $C0)
        )))

    [] projectile_animation_ball_red
        (make_anim(Fs{}(
            Fs(1, @sprite_projectile_ball_red)
        )))

    [] sprite_projectile_ball_grounded_red
        (make_metasprite(0, Ms{}(
            Ms( 0,-8, $9D, $20),
            Ms( 0, 0, $9D, $A0),
            Ms( 8,-8, $9D, $60),
            Ms( 8, 0, $9D, $E0)
        )))

    [] projectile_animation_ball_grounded_red
        (make_anim(Fs{}(
            Fs(1, @sprite_projectile_ball_grounded_red)
        )))

    [] sprite_warden_spike_red
        (make_metasprite(0, Ms{}(
            Ms( 0,-16, $AC, $00)
        )))

    [] projectile_animation_spike_red
        (make_anim(Fs{}(
            Fs(1, @sprite_warden_spike_red)
        )))

// Boss state constants
ct U WARDEN_STATE_IDLE = 0
ct U WARDEN_STATE_ATTACK = 1
ct U WARDEN_STATE_SHOOT = 2
ct U WARDEN_STATE_HURT = 3
ct U WARDEN_STATE_DEAD = 4

vars /game
    Bool warden_active = true
    U warden_health = 200
    SS warden_x = 180       // Coordinates for bg1.png placement
    SS warden_y = 120
    SS warden_w = 64
    SS warden_h = 64
    U warden_hurt_timer = 0
    U warden_state = WARDEN_STATE_IDLE
    U warden_timer = 0
    Bool warden_enraged = false

    // Projectile data
    Bool[3] warden_projectile_active
    SSF[3] warden_projectile_x
    SSF[3] warden_projectile_y
    SF[3] warden_projectile_vx
    SF[3] warden_projectile_vy
    U[3] warden_projectile_ground_timer
    AnimState[3] warden_projectile_anim

    // Spike wave data
    U warden_spike_wave_timer = 0
    U warden_spike_wave_count = 0
    SSF warden_spike_wave_origin_x
    SSF warden_spike_wave_origin_y
    S warden_spike_wave_dir = 0
    SSF[6] warden_spike_x
    SSF[6] warden_spike_y
    Bool[6] warden_spike_active
    U[6] warden_spike_timer
    AnimState[6] warden_spike_anim

fn warden_init(SS wx, SS wy)
    warden_active = true
    warden_health = 200
    warden_x = wx
    warden_y = wy + 64 // Offset to waist and legs (shifted 2 tiles down)
    warden_h = 32      // Height of waist and legs
    warden_hurt_timer = 0
    warden_state = WARDEN_STATE_IDLE
    warden_timer = 0
    warden_enraged = false
    for U i = 0; i < 3; i += 1
        warden_projectile_active[i] = false
        warden_projectile_ground_timer[i] = 0
        warden_projectile_anim[i] = make_anim_state(@projectile_animation_ball)
    
    warden_spike_wave_timer = 0
    warden_spike_wave_count = 0
    for U i = 0; i < 6; i += 1
        warden_spike_active[i] = false
        warden_spike_timer[i] = 0
        warden_spike_anim[i] = make_anim_state(@projectile_animation_spike)

fn update_warden()
    if !warden_active
        return

    update_warden_projectile()
    update_warden_spikes()

    // Once enraged, the Warden stays enraged until death
    if (p.x >> 3) >= 48
        warden_enraged = true

    if !warden_enraged
        return

    // Stop if player or warden is dead or health is 0
    if p.health == 0 || !warden_active || warden_state == WARDEN_STATE_DEAD
        return

    // Handle hurt timer
    if warden_hurt_timer > 0
        warden_hurt_timer -= 1
    
    // State machine
    warden_timer += 1
    
    switch warden_state
        case WARDEN_STATE_IDLE
            U wait_time = 120
            if warden_health < 100
                wait_time = 60 // Twice as fast at low health
            if warden_timer > wait_time
                warden_timer = 0
                warden_state = WARDEN_STATE_SHOOT
            break
            
        case WARDEN_STATE_SHOOT
            if warden_timer == 1
                warden_fire_projectile()
            
            if warden_timer > 60
                warden_timer = 0
                warden_state = WARDEN_STATE_IDLE
            break
            
        case WARDEN_STATE_HURT
            if warden_timer > 20
                warden_timer = 0
                warden_state = WARDEN_STATE_IDLE
            break

    // Collision with player
    if p.x < (warden_x + warden_w) && (p.x + p.w) > SS(warden_x) && SS(p.y) < (warden_y + warden_h) && (SS(p.y) + p.h) > warden_y
        hurt_player(ATTACK_BOSS)

fn warden_fire_projectile()
    U count = 1
    if warden_health < 100
        count = 3

    for U i = 0; i < count; i += 1
        if !warden_projectile_active[i]
            warden_projectile_active[i] = true
            warden_projectile_ground_timer[i] = 0
            warden_projectile_x[i] = 384
            warden_projectile_y[i] = 72
            
            // Aim at player
            SSF dx = SSF(p.x) - warden_projectile_x[i]
            SSF dy = SSF(SS(p.y) + 16) - warden_projectile_y[i]
            
            warden_projectile_vx[i] = SF(dx >> 6)
            warden_projectile_vy[i] = SF(dy >> 6)

            if count > 1
                if i == 1
                    warden_projectile_vx[i] -= 0.5
                    warden_projectile_vy[i] -= 0.25
                else if i == 2
                    warden_projectile_vx[i] += 0.5
                    warden_projectile_vy[i] += 0.25
            
            if warden_health < 100
                warden_projectile_anim[i] = make_anim_state(@projectile_animation_ball_red)
            else
                warden_projectile_anim[i] = make_anim_state(@projectile_animation_ball)

fn update_warden_projectile()
    for U i = 0; i < 3; i += 1
        if warden_projectile_active[i]
            // Handle movement and ground check ONLY if not yet on ground
            if warden_projectile_ground_timer[i] == 0
                warden_projectile_x[i] += warden_projectile_vx[i]
                warden_projectile_y[i] += warden_projectile_vy[i]
                
                if SS(warden_projectile_y[i]) > 184 && collision_at(UU(SS(warden_projectile_x[i]) + 8), UU(SS(warden_projectile_y[i]) + 16)) == C_WALL
                     warden_projectile_ground_timer[i] = 180
                     warden_projectile_y[i] += 14
                     if warden_health < 100
                        warden_projectile_anim[i] = make_anim_state(@projectile_animation_ball_grounded_red)
                     else
                        warden_projectile_anim[i] = make_anim_state(@projectile_animation_ball_grounded)
                     
                     // Start spike wave
                     warden_spike_wave_origin_x = warden_projectile_x[i]
                     warden_spike_wave_origin_y = warden_projectile_y[i] - 14 + 16 + 4
                     if p.x > SS(warden_projectile_x[i])
                        warden_spike_wave_dir = 1
                     else
                        warden_spike_wave_dir = -1
                     warden_spike_wave_timer = 1
                     warden_spike_wave_count = 0
            else
                // Already on ground, tick down timer
                warden_projectile_ground_timer[i] -= 1
                if warden_projectile_ground_timer[i] == 0
                    warden_projectile_active[i] = false
                    continue

            // Check collision with player
            if SS(warden_projectile_x[i]) < (p.x + p.w) && (SS(warden_projectile_x[i]) + 16) > p.x && SS(warden_projectile_y[i]) < (SS(p.y) + p.h) && (SS(warden_projectile_y[i]) + 16) > SS(p.y)
                if hurt_player(ATTACK_BOSS) || true
                    warden_projectile_active[i] = false
                continue
                
            // Offscreen check
            SS screen_x = SS(warden_projectile_x[i]) - p.camera_x
            if screen_x < -32 || screen_x > 288 || SS(warden_projectile_y[i]) < -16 || SS(warden_projectile_y[i]) > 240
                warden_projectile_active[i] = false
                continue
            
            warden_projectile_anim[i] = tick_anim(warden_projectile_anim[i], true)

fn update_warden_spikes()
    // Handle wave spawning
    if warden_spike_wave_timer > 0
        warden_spike_wave_timer += 1
        U speed = 15
        if warden_health < 100
            speed = 7 // Twice as fast
            
        if (warden_spike_wave_timer & speed) == 0
            if warden_spike_wave_count < 3
                U i = warden_spike_wave_count
                warden_spike_active[i] = true
                warden_spike_x[i] = warden_spike_wave_origin_x + SSF(S(i + 1) * warden_spike_wave_dir * 16)
                warden_spike_y[i] = warden_spike_wave_origin_y
                warden_spike_timer[i] = 180 // 3 seconds
                if warden_health < 100
                    warden_spike_anim[i] = make_anim_state(@projectile_animation_spike_red)
                else
                    warden_spike_anim[i] = make_anim_state(@projectile_animation_spike)
                
                // Low health mode: Spawn in opposite direction too
                if warden_health < 100
                    U j = i + 3
                    warden_spike_active[j] = true
                    warden_spike_x[j] = warden_spike_wave_origin_x - SSF(S(i + 1) * warden_spike_wave_dir * 16)
                    warden_spike_y[j] = warden_spike_wave_origin_y
                    warden_spike_timer[j] = 180
                    warden_spike_anim[j] = make_anim_state(@projectile_animation_spike_red)

                warden_spike_wave_count += 1
            else
                warden_spike_wave_timer = 0 // Finished wave
    
    // Update active spikes
    for U i = 0; i < 6; i += 1
        if warden_spike_active[i]
            // Tick animation
            warden_spike_anim[i] = tick_anim(warden_spike_anim[i], true)
            
            // Stay for 3 seconds then disappear
            warden_spike_timer[i] -= 1
            if warden_spike_timer[i] == 0
                warden_spike_active[i] = false
            
            // Collision with player
            if SS(warden_spike_x[i]) < (p.x + p.w) && (SS(warden_spike_x[i]) + 16) > p.x && (SS(warden_spike_y[i]) - 8) < (SS(p.y) + p.h) && (SS(warden_spike_y[i]) + 8) > SS(p.y)
                if hurt_player(ATTACK_BOSS) || true
                    warden_spike_active[i] = false

fn draw_warden_sprites(U o) U
    for U i = 0; i < 3; i += 1
        if warden_projectile_active[i]
            o = push_oam_anim(o, SS(warden_projectile_x[i]) - p.camera_x, SS(warden_projectile_y[i]), warden_projectile_anim[i])
    
    // Draw spikes
    for U i = 0; i < 6; i += 1
        if warden_spike_active[i]
            o = push_oam_anim(o, SS(warden_spike_x[i]) - p.camera_x, SS(warden_spike_y[i]), warden_spike_anim[i])

    // Triggered ball at tile X=48 (384), Y=72
    if warden_enraged && warden_state != WARDEN_STATE_DEAD
        AnimState anim
        if warden_health < 100
            anim = make_anim_state(@projectile_animation_ball_red)
        else
            anim = make_anim_state(@projectile_animation_ball)
        o = push_oam_anim(o, 384 - p.camera_x, 72, anim)

    return o
