macro("pool_contiguous", "Wheelbroken", "4", "wheelbrokens", "/game")

ct fn wheelbroken_vec(Int{} x, Int{} y) Wheelbroken{}
    Wheelbroken{} out = Wheelbroken{}()
    for UU i = 0; i < len(x); i += 1
        push(out, Wheelbroken(SS(x{i}), SS(y{i}), false, 0, 40, 0, 0, 0)) // 40 HP, 0 blocked_timer
    return out

struct Wheelbroken

    SS x
    SS y
    Bool facing_left
    U attack_timer
    U health
    U hurt_timer
    U blocked_timer
    U local_index


vars /enemies
    AnimState[4] wheelbroken_anim_state

vars /patrol
    SS[4] wheelbroken_patrol_center
    U[4] wheelbroken_patrol_dir

data /sprites
    [] sprite_wheelbroken_standing
        (make_metasprite(0, Ms{}(
            Ms(-8,-24, $D3, $01), Ms( 0,-24, $D4, $01), Ms( 8,-24, $D5, $01),
            Ms(-8,-16, $E3, $01), Ms( 0,-16, $E4, $01), Ms( 8,-16, $E5, $01),  
            Ms(-8, -8, $F3, $01), Ms( 0, -8, $F4, $01), Ms( 8, -8, $F5, $01)
        )))

    [] sprite_wheelbroken_standing_left
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms(-8,-24, $D3, $01), Ms( 0,-24, $D4, $01), Ms( 8,-24, $D5, $01),
            Ms(-8,-16, $E3, $01), Ms( 0,-16, $E4, $01), Ms( 8,-16, $E5, $01),  
            Ms(-8, -8, $F3, $01), Ms( 0, -8, $F4, $01), Ms( 8, -8, $F5, $01)
        )))

    [] sprite_wheelbroken_standing_attack
        (make_metasprite(0, Ms{}(
            Ms( 8,-32, $C8, $01), Ms( 16,-32, $C9, $01), Ms( 24,-32, $CA, $01),
            Ms(-8,-24, $D6, $01), Ms( 0,-24, $D7, $01), Ms( 8,-24, $D8, $01), Ms( 16,-24, $D9, $01), Ms(24,-24, $DA, $01),
            Ms(-8,-16, $E6, $01), Ms( 0,-16, $E7, $01), Ms( 8,-16, $E8, $01), Ms( 16,-16, $E9, $01),  
            Ms(-8, -8, $F6, $01), Ms( 0, -8, $F7, $01), Ms( 8, -8, $F8, $01), Ms( 16, -8, $F9, $01)
        )))

    [] sprite_wheelbroken_standing_attack_left
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms( 8,-32, $C8, $01), Ms( 16,-32, $C9, $01), Ms( 24,-32, $CA, $01),
            Ms(-8,-24, $D6, $01), Ms( 0,-24, $D7, $01), Ms( 8,-24, $D8, $01), Ms( 16,-24, $D9, $01), Ms(24,-24, $DA, $01),
            Ms(-8,-16, $E6, $01), Ms( 0,-16, $E7, $01), Ms( 8,-16, $E8, $01), Ms( 16,-16, $E9, $01),  
            Ms(-8, -8, $F6, $01), Ms( 0, -8, $F7, $01), Ms( 8, -8, $F8, $01), Ms( 16, -8, $F9, $01)
        )))

    [] wheelbroken_animation_standing
        (make_anim(Fs{}(
            Fs(1, @sprite_wheelbroken_standing)
        )))

    [] wheelbroken_animation_standing_left
        (make_anim(Fs{}(
            Fs(1, @sprite_wheelbroken_standing_left)
        )))
    
    [] wheelbroken_animation_attack
        (make_anim(Fs{}(
            Fs(1, @sprite_wheelbroken_standing_attack)
        )))

    [] wheelbroken_animation_attack_left
        (make_anim(Fs{}(
            Fs(1, @sprite_wheelbroken_standing_attack_left)
        )))

fn wheelbroken_delete_with_patrol(U ix)
    wheelbrokens_delete(ix)
    if ix < wheelbrokens_num
        wheelbroken_patrol_center[ix] = wheelbroken_patrol_center[wheelbrokens_num]
        wheelbroken_patrol_dir[ix] = wheelbroken_patrol_dir[wheelbrokens_num]

fn wheelbroken_update(U ix) Bool
    SS ex = wheelbrokens[ix].x
    SS ey = wheelbrokens[ix].y

    // Only update if enemy is on screen
    if ex < (p.camera_x - 16) || ex > (p.camera_x + 272)
        return true

    // Gravity check (optimized to run once every 4 frames)
    if (frame_counter & 3) == (ix & 3)
        U ground_tile = collision_at(UU(ex), UU(ey))
        if ground_tile != C_WALL && ground_tile != C_PLATFORM && ground_tile != C_JAIL
            wheelbrokens[ix].y += 8 // 2px per frame * 4 frames
            // Snap to floor if we landed
            U landed_tile = collision_at(UU(ex), UU(wheelbrokens[ix].y))
            if landed_tile == C_WALL || landed_tile == C_PLATFORM || landed_tile == C_JAIL
                wheelbrokens[ix].y = wheelbrokens[ix].y & -16
            ey = wheelbrokens[ix].y // refresh local copy of ey

    // Out of bounds check: delete if fallen into bottomless pit
    if ey > (SS(current_level_height) << 4)
        wheelbroken_delete_with_patrol(ix)
        return false

    if (frame_counter & 63) == 0
        logf3(@"WB ix:%d x:%d center:%d"l, ix, UU(ex), UU(wheelbroken_patrol_center[ix]))
        logf2(@"WB dir:%d blocked:%d"l, UU(wheelbroken_patrol_dir[ix]), UU(wheelbrokens[ix].blocked_timer))
    
    // Patrol: move 1px every other frame (half speed), flip on wall or 2-tile boundary
    if wheelbrokens[ix].blocked_timer == 0
        if (frame_counter & 1) == 0  // move every other frame = half speed
            SS center = wheelbroken_patrol_center[ix]
            U dir = wheelbroken_patrol_dir[ix]
            if dir == 1  // moving left
                wheelbrokens[ix].x -= 1
                if wheelbrokens[ix].x <= 8
                    dir = 0
                else
                    U check_wall = collision_at(UU(wheelbrokens[ix].x - 8), UU(ey - 8))
                    U check_floor = collision_at(UU(wheelbrokens[ix].x - 8), UU(ey))
                    if check_wall == C_WALL
                        dir = 0
                    else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                        dir = 0
                    else if wheelbrokens[ix].x <= (center - SS(32))
                        dir = 0
            else                            // moving right
                wheelbrokens[ix].x += 1
                if wheelbrokens[ix].x >= (SS(current_level_width) << 4) - 8
                    dir = 1
                else
                    U check_wall = collision_at(UU(wheelbrokens[ix].x + 8), UU(ey - 8))
                    U check_floor = collision_at(UU(wheelbrokens[ix].x + 8), UU(ey))
                    if check_wall == C_WALL
                        dir = 1
                    else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                        dir = 1
                    else if wheelbrokens[ix].x >= (center + SS(32))
                        dir = 1
            wheelbroken_patrol_dir[ix] = dir
            ex = wheelbrokens[ix].x  // refresh local copy after moving

    // Facing logic: Face player if within 5 tiles (40 pixels)
    SS dist_x = p.x - ex
    if dist_x < 0
        dist_x = -dist_x
    SS dist_y = SS(p.y) - ey
    if dist_y < 0
        dist_y = -dist_y

    if dist_x < 40 && dist_y < 40
        if p.x < ex
            wheelbrokens[ix].facing_left = true
        else
            wheelbrokens[ix].facing_left = false
    else
        wheelbrokens[ix].facing_left = (wheelbroken_patrol_dir[ix] == 1)

    if wheelbrokens[ix].hurt_timer > 0
        wheelbrokens[ix].hurt_timer -= 1

    // Body Hitbox (Player attacks Enemy)
    if player_sword_active
        SS sx = player_sword_x
        SS sy = player_sword_y
        // Body bounds: (ex-8, ey-24) to (ex+8, ey)
        if sx < (ex + 8) && (sx + player_sword_w) > (ex - 8) && sy < ey && (sy + player_sword_h) > (ey - 24)
             Bool is_combo = register_sword_hit()
             if wheelbrokens[ix].hurt_timer == 0
                 wheelbrokens[ix].hurt_timer = 30 // I-frames
                 player_pogo()
                 U power = p.attack_power
                 if is_combo
                     power = power << 1 // Double damage on combo hit!
                 if wheelbrokens[ix].blocked_timer > 0
                     power = power << 1 // Double damage when blocked
                 
                 if wheelbrokens[ix].health > power
                     wheelbrokens[ix].health -= power
                 else
                      wheelbrokens[ix].health = 0
                      U global_ix = (current_level_index << 3) + wheelbrokens[ix].local_index
                      U byte_ix = global_ix >> 3
                      U bit_ix = global_ix & 7
                      dead_wheelbrokens[byte_ix] |= (U(1) << bit_ix)
                      total_tears_collected += 13
                      wheelbroken_delete_with_patrol(ix)
                      return false

    if wheelbrokens[ix].blocked_timer > 0
        wheelbrokens[ix].blocked_timer -= 1
        wheelbrokens[ix].attack_timer = 0 // Stay idle while blocked
    else
        // Attack logic: Trigger when player is close
        if wheelbrokens[ix].attack_timer == 0
            if dist_x < 64 && dist_y < 32
                wheelbrokens[ix].attack_timer = 1
        else
            wheelbrokens[ix].attack_timer += 1
            if wheelbrokens[ix].attack_timer >= 120 // 2s total cycle
                wheelbrokens[ix].attack_timer = 0

    // Determine current state based on attack_timer
    // 0: Standing/Idle
    // 1-30: Wind-up (Still Standing)
    // 31-60: Active Attack (Attack Animation + Hitbox)
    // 61-120: Recovery (Standing)
    
    Bool is_attacking = wheelbrokens[ix].attack_timer >= 31 && wheelbrokens[ix].attack_timer <= 60

    // Wheel Hitbox (Enemy attacks Player)
    if is_attacking
        SS whx
        if wheelbrokens[ix].facing_left
            whx = ex - 32
        else
            whx = ex + 0
        SS why = ey - 32
        SS whw = 32
        SS whh = 24
        
        // Collision with player
        if p.hitbox_x < (whx + whw) && (p.hitbox_x + p.w) > whx && SS(p.y) < (why + whh) && (SS(p.y) + p.h) > why
            if hurt_player(ATTACK_PILGRIM, ex)
                // If parried, end attack phase early
                wheelbrokens[ix].attack_timer = 61
                wheelbrokens[ix].blocked_timer = 120 // Turn red for 2 seconds
    
    // Animation selection
    // Only update if it's different from the current animation to avoid resetting frames
    CCC/sprites anim_to_set
    if is_attacking
        if wheelbrokens[ix].facing_left
            anim_to_set = @wheelbroken_animation_attack_left
        else
            anim_to_set = @wheelbroken_animation_attack
    else
        if wheelbrokens[ix].facing_left
            anim_to_set = @wheelbroken_animation_standing_left
        else
            anim_to_set = @wheelbroken_animation_standing
            
    if UU(wheelbroken_anim_state[ix].frames) != UU(anim_to_set)
        wheelbroken_anim_state[ix] = make_anim_state(anim_to_set)



    // Basic collision with player (contact damage)
    if p.hitbox_x < (ex + 8) && (p.hitbox_x + p.w) > (ex - 8) && SS(p.y) < SS(ey) && (SS(p.y) + p.h) > (ey - 24)
        if hurt_player(ATTACK_PILGRIM, ex)
            // Parried the body!
            wheelbrokens[ix].blocked_timer = 120
            wheelbrokens[ix].attack_timer = 0



    
    return true

fn draw_wheelbrokens(U o) U
    if wheelbrokens_num == 0
        return o
        
    U start = frame_counter & 7
    if start >= wheelbrokens_num
        start = 0
    for U j = 0; j < wheelbrokens_num; j += 1
        U i = start + j
        if i >= wheelbrokens_num
            i -= wheelbrokens_num
            
        if wheelbroken_update(i)
            SS x = SS(wheelbrokens[i].x) - p.camera_x
            SS y = wheelbrokens[i].y
            if wheelbrokens[i].hurt_timer > 0
                o = push_oam_anim_a(o, x, y, wheelbroken_anim_state[i], $02) // White flash
            else if wheelbrokens[i].blocked_timer > 0
                o = push_oam_anim_a(o, x, y, wheelbroken_anim_state[i], $03) // XOR Palette 1 with $03 to get Palette 2 (Red?)
            else
                o = push_oam_anim(o, x, y, wheelbroken_anim_state[i])
    return o
