/*
 * BlasNESmous - Main
 * Based on LuciYFer engine
 */

// Button constants
ct Int SELECT_BUTTON_DEBOUNCE_FRAMES = 70
ct Int START_BUTTON_DEBOUNCE_FRAMES = 5

// Game states
ct Int GAME_STATE_TITLE = 1
ct Int GAME_STATE_PLAY = 2
ct Int GAME_STATE_WIN = 3
ct Int GAME_STATE_MAP = 4
ct Int GAME_STATE_GAME_OVER = 63

ct U GAME_MODE_NORMAL = 0
ct U GAME_MODE_KONAMI = 1

// Controller data
vars /controller
    Bool is_start_pressed = false
    U start_counter = 0
    Bool is_select_pressed = false
    U select_counter = 0
    
asm fn irq_enable()
: employs
    cli
    rts

// Game data
vars /game
    Player p = Player()
    U game_state = GAME_STATE_TITLE
    U frame_counter = 0
    Bool[NUMBER_OF_KEYS] keys
    Bool[NUMBER_OF_KEYS] show_key = Bool[NUMBER_OF_KEYS](true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true)
    U[NUMBER_OF_KEYS] key_x
    U[NUMBER_OF_KEYS] key_y
    Bool is_game_paused = false
    U load_level_counter = 0
    U game_mode = GAME_MODE_NORMAL
    U cheat_index = 0
    U level_cheat_index = 0
    U cheat_timer = 0
    U cheat_shake_timer = 0
    Bool prie_dieu_lit = false
    U last_prie_dieu_level = 0
    SS last_prie_dieu_x = 0
    SS last_prie_dieu_y = 0
    Bool spawn_from_right = false
    Bool spawn_from_top = false
    Bool spawn_from_bottom = false
    U[20] dead_pilgrims = U[20](0)
    U[20] dead_wheelbrokens = U[20](0)
    U[4] explored_rooms = U[4](0, 0, 0, 0)
    U[20] dead_eyes = U[20](0)
    U[20] dead_following_eyes = U[20](0)
    U[20] dead_crucifieds = U[20](0)
    Bool warden_defeated = false
    Bool warden_arrow_dismissed = false
    Bool mea_culpa_upgraded = false
    U bile_vessel_hp = 18
    U fps_ticks = 0
    U fps_display = 60
    U fps_timer = 0
    U total_bones_collected = 0

data /game
    [] konami_code
        U[10](BUTTON_UP, BUTTON_UP, BUTTON_DOWN, BUTTON_DOWN, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_B, BUTTON_A)
    [] level_cheat_code
        U[4](BUTTON_B, BUTTON_A, BUTTON_B, BUTTON_A)

struct MapCoord
    U x
    U y
    Bool is_vertical

ct MapCoord[] level_map_coords = MapCoord[](
    MapCoord(0, 0, false),   // 0: Title
    MapCoord(5, 10, false),  // 1: Level 1
    MapCoord(6, 10, false),  // 2: Level 2
    MapCoord(7, 10, false),  // 3: Level 3
    MapCoord(8, 10, false),  // 4: Level 4
    MapCoord(8, 11, true),   // 5: Level 4 Sub1
    MapCoord(9, 10, false),  // 6: Level 5
    MapCoord(10, 10, false), // 7: Level 6
    MapCoord(11, 10, false), // 8: Level 7
    MapCoord(11, 9, true),   // 9: Level 7over1
    MapCoord(12, 10, false), // 10: Level 8
    MapCoord(13, 10, false), // 11: Level 9
    MapCoord(14, 10, false), // 12: Level 10
    MapCoord(13, 11, true),  // 13: Level 9sub1
    MapCoord(13, 9, true),   // 14: Level 9over1
    MapCoord(13, 8, true),   // 15: Level 9over2
    MapCoord(14, 11, true),  // 16: Level 10sub1
    MapCoord(12, 9, true),   // 17: Level 8over1
    MapCoord(15, 10, false)  // 18: Game Over
)

// IRQ
irq game_irq()
    {MMC3_IRQ_DISABLE}(0) // Acknowledge and disable
    
    if game_state != GAME_STATE_PLAY
        return
    // Restore Level Bank for the gameplay area
    mmc3_select(0, current_level_chr << 3)
    mmc3_select(1, (current_level_chr << 3) + 2)

    // Set Level Scroll
    U shake_x = 0
    U shake_y = 0
    if (warden_active && warden_hurt_timer > 0) || cheat_shake_timer > 0
        shake_x = frame_counter & 3
        shake_y = (frame_counter >> 1) & 3
        
    {PPUSCROLL}(p.camera_x.a + shake_x)
    {PPUSCROLL}(shake_y)
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000 | (p.camera_x.b & 1))

// NMI
nmi game_nmi()
    frame_counter = frame_counter + 1
    fps_timer += 1
    if fps_timer >= 60
        fps_timer = 0
        fps_display = fps_ticks
        fps_ticks = 0


    ppu_upload_oam_poll_pads(0)

    // Update button counters before potential early return
    if pads[0].held & BUTTON_SELECT
        select_counter += 1
        if select_counter == SELECT_BUTTON_DEBOUNCE_FRAMES
            select_counter = 0
            is_select_pressed = true
    else
        select_counter = 0

    if pads[0].held & BUTTON_START
        start_counter += 1
        if start_counter == START_BUTTON_DEBOUNCE_FRAMES
            start_counter = 0
            is_start_pressed = true
    else
        start_counter = 0

    if current_level_index == 18 || game_state != GAME_STATE_PLAY
        hide_oam(0) // Hide all sprites (in case HUD uses them)
        {MMC3_IRQ_DISABLE}(0)
        if game_state == GAME_STATE_GAME_OVER || game_state == GAME_STATE_MAP || game_state == GAME_STATE_WIN
            mmc3_select(0, current_level_chr << 3)
            mmc3_select(1, (current_level_chr << 3) + 2)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
        return
    else
        // Set IRQ for scanline 15 (end of HUD split)
        // Set as early as possible to ensure it starts counting from scanline 0
        mmc3_timer(15)

        // Set HUD Bank for the top of the screen
        mmc3_select(0, CHR_HUD << 3)
        mmc3_select(1, (CHR_HUD << 3) + 2)

        ppu_upload_scroll()
        update_hud_tiles() // Call after scroll upload to ensure priority
        
        // Set HUD scroll (0,0)
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)

        // Flash red when hurt, solid red when dead
        if warden_active && (warden_state == WARDEN_STATE_DEAD || (warden_hurt_timer > 0 && (frame_counter & 2)))
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP | $20) // Tint screen red
        else
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)



// MAIN
mode main()  
    mmc3_reset()
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)    
    p.level_index = FIRST_LEVEL_INDEX
    current_level_index = FIRST_LEVEL_INDEX
    p.is_initialised = false
    p.camera_x = 0
    load_level(levels[current_level_index])
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)

    while true
        switch game_state
            case GAME_STATE_TITLE
                current_level_index = 0
                goto mode title_screen(current_level_index)
                : preserves /game
                break
            case GAME_STATE_MAP
                goto mode map_screen(current_level_index)
                : preserves /game
                break
            default
                current_level_index = p.level_index
                p.is_initialised = false
                goto mode play_level(current_level_index)
                : preserves /game
                break

mode play_level(U level_index)
: nmi game_nmi
: irq game_irq
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    load_level(levels[level_index])
    
    // Mark as explored
    explored_rooms[level_index >> 3] |= (U(1) << (level_index & 7))

    if !p.is_initialised
        p = make_player_penitent()
    
    if spawn_from_right
        p.x = (SS(current_level_width) << 4) - 32
        p.camera_x = p.x - 128
        spawn_from_right = false
    if spawn_from_top || spawn_from_bottom
        p.camera_x = max(0, min(p.center_x - 128, (SS(current_level_width) << 4) - 256))
        if spawn_from_top
            p.y = 2
            spawn_from_top = false
        else
            p.y = SSF((SS(current_level_height) << 4) - SS(p.h) - 2)
            spawn_from_bottom = false

    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    irq_enable()
    
    while true
        nmi
        fps_ticks += 1
        update_pads()
        check_pause()
        // export_hitboxes()
        if !is_game_paused
            update_player()
            level_update()
            check_cheats()
            update_sprites()
            update_scroll()

            if is_select_pressed
                is_select_pressed = false
                game_state = GAME_STATE_MAP
                goto mode map_screen(current_level_index)
                : preserves /game
        else
            update_pause_sprites()

ct Int HITBOX_EXPORT_ADDR = $4018

fn export_hitboxes()
    {HITBOX_EXPORT_ADDR}($77)
    {HITBOX_EXPORT_ADDR}($88)
    {HITBOX_EXPORT_ADDR}($99)
    {HITBOX_EXPORT_ADDR}($AA)

    {HITBOX_EXPORT_ADDR}(p.hitbox_x.a)
    {HITBOX_EXPORT_ADDR}(p.hitbox_x.b)
    
    SS py_int = SS(p.y)
    {HITBOX_EXPORT_ADDR}(py_int.a)
    {HITBOX_EXPORT_ADDR}(py_int.b)
    
    {HITBOX_EXPORT_ADDR}(p.w.a)
    {HITBOX_EXPORT_ADDR}(p.w.b)
    
    {HITBOX_EXPORT_ADDR}(p.h.a)
    {HITBOX_EXPORT_ADDR}(p.h.b)
    
    {HITBOX_EXPORT_ADDR}(warden_x.a)
    {HITBOX_EXPORT_ADDR}(warden_x.b)
    
    SS wy_int = SS(warden_y)
    {HITBOX_EXPORT_ADDR}(wy_int.a)
    {HITBOX_EXPORT_ADDR}(wy_int.b)
    
    {HITBOX_EXPORT_ADDR}(warden_w.a)
    {HITBOX_EXPORT_ADDR}(warden_w.b)
    
    {HITBOX_EXPORT_ADDR}(warden_h.a)
    {HITBOX_EXPORT_ADDR}(warden_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(warden_active))
    
    {HITBOX_EXPORT_ADDR}(p.camera_x.a)
    {HITBOX_EXPORT_ADDR}(p.camera_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_x.a)
    {HITBOX_EXPORT_ADDR}(player_sword_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_y.a)
    {HITBOX_EXPORT_ADDR}(player_sword_y.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_w.a)
    {HITBOX_EXPORT_ADDR}(player_sword_w.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_h.a)
    {HITBOX_EXPORT_ADDR}(player_sword_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(player_sword_active))

    {HITBOX_EXPORT_ADDR}(warden_health)

    // Export Enraged Pilgrims (max 8)
    {HITBOX_EXPORT_ADDR}(enraged_pilgrims_num)
    for U i = 0; i < 8; i += 1
        if i < enraged_pilgrims_num
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].x.a)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].x.b)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].y.a)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].y.b)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].health)
        else
            for U j = 0; j < 5; j += 1
                {HITBOX_EXPORT_ADDR}(0)

    // Export Wheelbrokens (max 8)
    {HITBOX_EXPORT_ADDR}(wheelbrokens_num)
    for U i = 0; i < 8; i += 1
        if i < wheelbrokens_num
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].x.a)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].x.b)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].y.a)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].y.b)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].health)
        else
            for U j = 0; j < 5; j += 1
                {HITBOX_EXPORT_ADDR}(0)
    
    // Padding to reach 120 bytes exactly (115 + 5)
    {HITBOX_EXPORT_ADDR}(game_mode)
    for U i = 0; i < 4; i += 1
        {HITBOX_EXPORT_ADDR}(0)

fn draw_enemies(U o) U
    U type_cycle = (frame_counter >> 3) & 3 // Rotate every 8 frames
    
    if type_cycle == 0
        o = draw_eyes(o)
        o = draw_enraged_pilgrims(o)
        o = draw_wheelbrokens(o)
        o = draw_crucifieds(o)
    else if type_cycle == 1
        o = draw_enraged_pilgrims(o)
        o = draw_wheelbrokens(o)
        o = draw_crucifieds(o)
        o = draw_eyes(o)
    else if type_cycle == 2
        o = draw_wheelbrokens(o)
        o = draw_crucifieds(o)
        o = draw_eyes(o)
        o = draw_enraged_pilgrims(o)
    else
        o = draw_crucifieds(o)
        o = draw_eyes(o)
        o = draw_enraged_pilgrims(o)
        o = draw_wheelbrokens(o)

    return o

fn draw_eyes(U o) U
    U e_start = frame_counter & 7
    if e_start >= enemies_eye_num
        e_start = 0
    for U j = 0; j < enemies_eye_num; j += 1
        U i = (e_start + j)
        if i >= enemies_eye_num
            i -= enemies_eye_num
        
        // Eye hit detection
        if player_sword_active && eye_hurt_timer[i] == 0
            if player_sword_x < SS(enemies_eye[i].x + 16) && (player_sword_x + player_sword_w) > SS(enemies_eye[i].x) && player_sword_y < SS(enemies_eye[i].y) && (player_sword_y + player_sword_h) > SS(enemies_eye[i].y - 8)
                eye_hurt_timer[i] = 30
                player_pogo()

        if eye_hurt_timer[i] > 0
            eye_hurt_timer[i] -= 1
            o = push_oam_anim_a(o, enemies_eye[i].x, enemies_eye[i].y, enemies_eye_anim_state[i], $01) // Palette 2 XOR 1 = 3 (White)
        else if eye_blocked_timer[i] > 0
            eye_blocked_timer[i] -= 1
            o = push_oam_anim_a(o, enemies_eye[i].x, enemies_eye[i].y, enemies_eye_anim_state[i], $03) // Palette 2 XOR 3 = 1
        else
            o = push_oam_anim(o, enemies_eye[i].x, enemies_eye[i].y, enemies_eye_anim_state[i])

    U fe_start = frame_counter & 7
    if fe_start >= enemies_following_eye_num
        fe_start = 0
    for U j = 0; j < enemies_following_eye_num; j += 1
        U i = (fe_start + j)
        if i >= enemies_following_eye_num
            i -= enemies_following_eye_num
        following_eye_update(i)

        // Following Eye hit detection
        if player_sword_active && following_eye_hurt_timer[i] == 0
            if player_sword_x < SS(enemies_following_eye[i].x + 16) && (player_sword_x + player_sword_w) > SS(enemies_following_eye[i].x) && player_sword_y < SS(enemies_following_eye[i].y + 16) && (player_sword_y + player_sword_h) > SS(enemies_following_eye[i].y)
                following_eye_hurt_timer[i] = 30
                player_pogo()

        if following_eye_hurt_timer[i] > 0
            following_eye_hurt_timer[i] -= 1
            o = push_oam_anim_a(o, enemies_following_eye[i].x, enemies_following_eye[i].y, enemies_following_eye_anim_state[i], $01) // White
        else if following_eye_blocked_timer[i] > 0
            o = push_oam_anim_a(o, enemies_following_eye[i].x, enemies_following_eye[i].y, enemies_following_eye_anim_state[i], $03)
        else
            o = push_oam_anim(o, enemies_following_eye[i].x, enemies_following_eye[i].y, enemies_following_eye_anim_state[i])
    
    return o


fn draw_player_secondary(U o, U attr_xor) U
    if p.hurt_timer == 0 || (frame_counter & 2) == 0
        o = push_oam_anim_palette(o, p.center_x - p.camera_x - 8, SS(p.y) + p.h, p.anim_state, 1, attr_xor)
    return o

fn update_sprites()
    if current_level_index == 18
        hide_oam(0)
        return
    U o = 0

    // Sprite 0 for HUD split (Must be at OAM index 0)
    // Placed at X=240, Y=14. Set to be behind background ($20) to hide it.
    // REMOVED: Scanline IRQ is now used instead.

    // Stage 1: Player Primary (Always Stable)
    U attr_xor = 0
    if p.heal_timer > 0
        attr_xor = 2
    if p.hurt_timer == 0 || (frame_counter & 2) == 0
        o = push_oam_anim_palette(o, p.center_x - p.camera_x - 8, SS(p.y) + p.h, p.anim_state, 0, attr_xor)

    // Stage 1.5: Items (High priority to avoid 64-sprite limit drops)
    o = draw_item_bones(o)

    // Stage 2: Rotating Priority (Flickering Group)
    U cycle = frame_counter & 7
    if cycle == 0
        o = draw_enemies(o)
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, attr_xor)
    else if cycle == 1
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, attr_xor)
        o = draw_enemies(o)
    else if cycle == 2
        o = draw_player_secondary(o, attr_xor)
        o = draw_enemies(o)
        o = level_draw_sprites(o)
    else if cycle == 3
        o = level_draw_sprites(o)
        o = draw_enemies(o)
        o = draw_player_secondary(o, attr_xor)
    else if cycle == 4
        o = draw_enemies(o)
        o = draw_player_secondary(o, attr_xor)
        o = level_draw_sprites(o)
    else
        // Items and everything else
        o = draw_item_bones(o)
        o = draw_enemies(o)
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, attr_xor)



    // Draw Warden Defeated Arrow
    if warden_defeated && !warden_arrow_dismissed && current_level_index == 1 && (frame_counter & 16)
        set_oam(o, 240, 120, $3F, 0)
        o += 4

    hide_oam(o)

    // Tick animations
    if p.movement == PLAYER_MOVING_CLIMB && (pads[0].held & (BUTTON_UP | BUTTON_DOWN)) == 0
        // Pause climb animation when not moving
    else
        p.anim_state = tick_anim(p.anim_state, true)
    for U i = 0; i < enemies_eye_num; i += 1
        enemies_eye_anim_state[i] = tick_anim(enemies_eye_anim_state[i], true)
    for U i = 0; i < enemies_following_eye_num; i += 1
        enemies_following_eye_anim_state[i] = tick_anim(enemies_following_eye_anim_state[i], true)
    for U i = 0; i < enraged_pilgrims_num; i += 1
        enraged_pilgrim_anim_state[i] = tick_anim(enraged_pilgrim_anim_state[i], true)
    for U i = 0; i < wheelbrokens_num; i += 1
        wheelbroken_anim_state[i] = tick_anim(wheelbroken_anim_state[i], true)
    for U i = 0; i < crucifieds_num; i += 1
        crucified_anim_state[i] = tick_anim(crucified_anim_state[i], true)
    for U i = 0; i < item_bones_num; i += 1
        item_bone_anim_state[i] = tick_anim(item_bone_anim_state[i], true)

fn update_pause_sprites()
    {PPUMASK}(PPUMASK_GRAYSCALE | PPUMASK_ON | PPUMASK_NO_CLIP)

fn check_pause()
    if is_start_pressed 
        is_game_paused = !is_game_paused
        is_start_pressed = false

fn check_cheats()
    U pressed = pads[0].pressed
    if pressed != 0
        cheat_timer = 0
        
        // Konami Code
        CCC/game kcode = @konami_code
        if pressed == kcode[cheat_index]
            cheat_index += 1
            if cheat_index == 10
                cheat_index = 0
                cheat_shake_timer = 60 // Shake for 1 second
                if game_mode == GAME_MODE_NORMAL
                    game_mode = GAME_MODE_KONAMI
                    p.health = 50
                else
                    game_mode = GAME_MODE_NORMAL
                    p.health = 70
        else
            if pressed == kcode[0]
                cheat_index = 1
            else
                cheat_index = 0

        // Level Cheat (B A B A + Direction)
        CCC/game lcode = @level_cheat_code
        if level_cheat_index < 4
            if pressed == lcode[level_cheat_index]
                level_cheat_index += 1
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0
        else
            if pressed == BUTTON_RIGHT
                // Next level
                level_cheat_index = 0
                cheat_shake_timer = 30
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game

            else if pressed == BUTTON_LEFT
                // Previous level
                level_cheat_index = 0
                cheat_shake_timer = 30
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0

        // "Shift" shortcuts (SELECT + Left/Right/Start)
        if (pads[0].held & BUTTON_SELECT)
            if pressed == BUTTON_START || pressed == BUTTON_RIGHT
                select_counter = 0 // Prevent map screen opening
                cheat_shake_timer = 30
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.x = PLAYER_INITIAL_X
                p.y = SSF(PLAYER_INITIAL_Y)
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game

            else if pressed == BUTTON_LEFT
                select_counter = 0 // Prevent map screen opening
                cheat_shake_timer = 30
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                spawn_from_right = true
                p.y = SSF(PLAYER_INITIAL_Y)
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
    else
        cheat_timer += 1
        if cheat_timer > 120
            cheat_index = 0
            level_cheat_index = 0
            cheat_timer = 0
    
    if cheat_shake_timer > 0
        cheat_shake_timer -= 1

// MAP SCREEN
mode map_screen(U previous_level)
: nmi game_nmi
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    // Save state so we can render the map properly at origin
    SS saved_camera = p.camera_x
    p.camera_x = 0
    current_level_index = 255 // Dummy value to prevent level_init side effects
    
    // Clear HUD rows from nametables so they don't show artifacts
    clear_hud_rows()

    // Load the map level graphics, palettes, and metatiles using the mapfab level
    load_level(@lev_map)

    // Ensure PPU is at 0,0 scroll before we start
    ppu_reset_scroll(0, 0)
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)

    while true
        nmi
        
        U o = 0
        
        // Draw Explored Room Markers
        for U i = 0; i < 19; i += 1
            if (explored_rooms[i >> 3] & (U(1) << (i & 7))) != 0
                MapCoord rc = level_map_coords[i]
                if rc.x != 0 || rc.y != 0 // Don't draw title screen/invalid coords
                    U tile = $2A
                    if rc.is_vertical
                        tile = $3A
                    set_oam(o, rc.x << 3, (rc.y + 1) << 3, tile, 0)
                    o += 4

        // Draw Player Marker over the map
        MapCoord pc = level_map_coords[previous_level]
        if (frame_counter & 16) != 0 // Flash every 16 frames
            // Horizontal: 1/32 scale (8px per screen)
            // Vertical: 1/16 scale (16px per screen)
            SS map_px = (SS(pc.x) << 3) + (p.x >> 5)
            SS map_py = ((SS(pc.y) + 1) << 3) + (SS(p.y) >> 4) - 11
            set_oam(o, map_px.a, map_py.a, $3E, 1) // Using Palette 1
            o += 4
        
        hide_oam(o)
        
        ppu_upload_oam_poll_pads(0)
        update_pads()
        
        if is_select_pressed || is_start_pressed
            is_select_pressed = false
            is_start_pressed = false
            
            // Restore state
            current_level_index = previous_level
            p.camera_x = saved_camera
            
            game_state = GAME_STATE_PLAY
            goto mode play_level(previous_level)
            : preserves /game

