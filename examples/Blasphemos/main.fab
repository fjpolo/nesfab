/*
 * BlasNESmous - Main
 * Based on LuciYFer engine
 */

// Button constants
ct Int SELECT_BUTTON_DEBOUNCE_FRAMES = 5
ct Int START_BUTTON_DEBOUNCE_FRAMES = 5

// Game states
ct Int GAME_STATE_START = 0
ct Int GAME_STATE_STORY = 1
ct Int GAME_STATE_TIPS = 2
ct Int GAME_STATE_PLAY = 3
ct Int GAME_STATE_WIN = 4
ct Int GAME_STATE_GAME_OVER = 63

ct U GAME_MODE_NORMAL = 0
ct U GAME_MODE_KONAMI = 1

// Controller data
vars /controller
    Bool is_start_pressed = false
    U start_counter = 0
    Bool is_select_pressed = false
    U select_counter = 0

// Game data
vars /game
    Player p = Player()
    U game_state = GAME_STATE_PLAY
    U frame_counter = 0
    Bool[NUMBER_OF_KEYS] keys
    Bool[NUMBER_OF_KEYS] show_key = Bool[NUMBER_OF_KEYS](true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true)
    U[NUMBER_OF_KEYS] key_x
    U[NUMBER_OF_KEYS] key_y
    Bool is_game_paused = false
    U load_level_counter = 0
    U game_mode = GAME_MODE_NORMAL
    U cheat_index = 0
    U level_cheat_index = 0
    U cheat_timer = 0
    U cheat_shake_timer = 0
    Bool prie_dieu_lit = false
    U last_prie_dieu_level = 0

data /game
    [] konami_code
        U[10](BUTTON_UP, BUTTON_UP, BUTTON_DOWN, BUTTON_DOWN, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_B, BUTTON_A)
    [] level_cheat_code
        U[4](BUTTON_B, BUTTON_A, BUTTON_B, BUTTON_A)

// NMI
nmi game_nmi()
    frame_counter = frame_counter + 1

    if game_state == GAME_STATE_STORY || game_state == GAME_STATE_TIPS
        if ready && writing == WRITING_READY
            {PPUSTATUS}()
            {PPUADDR}(cur_addr.b)
            {PPUADDR}(cur_addr.a)
            {PPUDATA}(char)
            cur_addr += 1
            writing = WRITING_WAIT
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUMASK}(PPUMASK_BG_ON)
    else
        ppu_upload_scroll()
        U shake_x = 0
        U shake_y = 0
        if (warden_active && warden_hurt_timer > 0) || cheat_shake_timer > 0
            shake_x = frame_counter & 3
            shake_y = (frame_counter >> 1) & 3
        
        ppu_reset_scroll(p.camera_x.a + shake_x, shake_y)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000 | (p.camera_x.b & 1))
        
        // Flash red when hurt, solid red when dead
        if warden_active && (warden_state == WARDEN_STATE_DEAD || (warden_hurt_timer > 0 && (frame_counter & 2)))
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP | $20) // Tint screen red
        else
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
    
    ppu_upload_oam_poll_pads(0)

    // Select pressed?
    if pads[0].held & BUTTON_SELECT
        select_counter += 1
        if select_counter == SELECT_BUTTON_DEBOUNCE_FRAMES
            select_counter = 0
            is_select_pressed = true
    else
        select_counter = 0

    // Start pressed?
    if pads[0].held & BUTTON_START
        start_counter += 1
        if start_counter == START_BUTTON_DEBOUNCE_FRAMES
            start_counter = 0
            is_start_pressed = true
    else
        start_counter = 0

// MAIN
mode main()  
    mmc3_reset()
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)    
    p.level_index = FIRST_LEVEL_INDEX
    current_level_index = FIRST_LEVEL_INDEX
    p.is_initialised = false
    p.camera_x = 0
    load_level(levels[current_level_index])
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)

    while true
        switch game_state
            case GAME_STATE_START
                current_level_index = LAST_LEVEL_INDEX + 1
                goto mode start_screen(current_level_index)
                : preserves /game
                break
            case GAME_STATE_STORY
                current_level_index = LAST_LEVEL_INDEX + 2
                goto mode story_screen(current_level_index)
                : preserves /game
                break
            case GAME_STATE_TIPS
                current_level_index = LAST_LEVEL_INDEX + 3
                goto mode tips_screen(current_level_index)
                : preserves /game
                break
            default
                current_level_index = p.level_index
                p.is_initialised = false
                goto mode play_level(current_level_index)
                : preserves /game
                break

mode play_level(U level_index)
: nmi game_nmi
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    load_level(levels[level_index])

    if !p.is_initialised
        p = make_player_penitent()

    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    
    while true
        nmi
        update_pads()
        check_pause()
        if !is_game_paused
            update_player()
            level_update()
            check_cheats()
            update_sprites()
            update_scroll()
            export_hitboxes()
        else
            update_pause_sprites()

ct Int HITBOX_EXPORT_ADDR = $FE

fn export_hitboxes()
    {HITBOX_EXPORT_ADDR}(p.hitbox_x.a)
    {HITBOX_EXPORT_ADDR}(p.hitbox_x.b)
    
    SS py_int = SS(p.y)
    {HITBOX_EXPORT_ADDR}(py_int.a)
    {HITBOX_EXPORT_ADDR}(py_int.b)
    
    {HITBOX_EXPORT_ADDR}(p.w.a)
    {HITBOX_EXPORT_ADDR}(p.w.b)
    
    {HITBOX_EXPORT_ADDR}(p.h.a)
    {HITBOX_EXPORT_ADDR}(p.h.b)
    
    {HITBOX_EXPORT_ADDR}(warden_x.a)
    {HITBOX_EXPORT_ADDR}(warden_x.b)
    
    SS wy_int = SS(warden_y)
    {HITBOX_EXPORT_ADDR}(wy_int.a)
    {HITBOX_EXPORT_ADDR}(wy_int.b)
    
    {HITBOX_EXPORT_ADDR}(warden_w.a)
    {HITBOX_EXPORT_ADDR}(warden_w.b)
    
    {HITBOX_EXPORT_ADDR}(warden_h.a)
    {HITBOX_EXPORT_ADDR}(warden_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(warden_active))
    
    {HITBOX_EXPORT_ADDR}(p.camera_x.a)
    {HITBOX_EXPORT_ADDR}(p.camera_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_x.a)
    {HITBOX_EXPORT_ADDR}(player_sword_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_y.a)
    {HITBOX_EXPORT_ADDR}(player_sword_y.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_w.a)
    {HITBOX_EXPORT_ADDR}(player_sword_w.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_h.a)
    {HITBOX_EXPORT_ADDR}(player_sword_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(player_sword_active))

fn draw_enemies(U o) U
    U e_start = frame_counter & 7
    if e_start >= enemies_eye_num
        e_start = 0
    for U j = 0; j < enemies_eye_num; j += 1
        U i = (e_start + j)
        if i >= enemies_eye_num
            i -= enemies_eye_num
        if eye_blocked_timer[i] > 0
            eye_blocked_timer[i] -= 1
            o = push_oam_anim_a(o, enemies_eye[i].x, enemies_eye[i].y, enemies_eye_anim_state[i], $03)
        else
            o = push_oam_anim(o, enemies_eye[i].x, enemies_eye[i].y, enemies_eye_anim_state[i])
        o += 4

    U fe_start = frame_counter & 7
    if fe_start >= enemies_following_eye_num
        fe_start = 0
    for U j = 0; j < enemies_following_eye_num; j += 1
        U i = (fe_start + j)
        if i >= enemies_following_eye_num
            i -= enemies_following_eye_num
        following_eye_update(i)
        if following_eye_blocked_timer[i] > 0
            o = push_oam_anim_a(o, enemies_following_eye[i].x, enemies_following_eye[i].y, enemies_following_eye_anim_state[i], $03)
        else
            o = push_oam_anim(o, enemies_following_eye[i].x, enemies_following_eye[i].y, enemies_following_eye_anim_state[i])
        o += 4

    o = draw_enraged_pilgrims(o)
    o = draw_wheelbrokens(o)

    return o

fn update_sprites()
    U o = 0

    // Draw Health (highest priority) - Each heart is 10 HP
    for U i = 0; i < 7; i += 1
        if p.health >= U((i + 1) * 10)
            set_oam(o, 8 + (i << 3), 8, $0B, 0)
            o += 4

    if (frame_counter & 1) == 0
        // Order: Enemies -> Level-specific -> Player
        o = draw_enemies(o)
        o = level_draw_sprites(o)
        if p.hurt_timer == 0 || (frame_counter & 2) == 0
            o = push_oam_anim(o, p.center_x - p.camera_x - 8, SS(p.y) + p.h, p.anim_state)
    else
        // Order: Player -> Level-specific -> Enemies
        if p.hurt_timer == 0 || (frame_counter & 2) == 0
            o = push_oam_anim(o, p.center_x - p.camera_x - 8, SS(p.y) + p.h, p.anim_state)
        o = level_draw_sprites(o)
        o = draw_enemies(o)



    hide_oam(o)

    // Tick animations
    if p.movement == PLAYER_MOVING_CLIMB && (pads[0].held & (BUTTON_UP | BUTTON_DOWN)) == 0
        // Pause climb animation when not moving
    else
        p.anim_state = tick_anim(p.anim_state, true)
    for U i = 0; i < enemies_eye_num; i += 1
        enemies_eye_anim_state[i] = tick_anim(enemies_eye_anim_state[i], true)
    for U i = 0; i < enemies_following_eye_num; i += 1
        enemies_following_eye_anim_state[i] = tick_anim(enemies_following_eye_anim_state[i], true)
    for U i = 0; i < enraged_pilgrims_num; i += 1
        enraged_pilgrim_anim_state[i] = tick_anim(enraged_pilgrim_anim_state[i], true)
    for U i = 0; i < wheelbrokens_num; i += 1
        wheelbroken_anim_state[i] = tick_anim(wheelbroken_anim_state[i], true)

fn update_pause_sprites()
    {PPUMASK}(PPUMASK_GRAYSCALE | PPUMASK_ON | PPUMASK_NO_CLIP)

fn check_pause()
    if is_start_pressed 
        is_game_paused = !is_game_paused
        is_start_pressed = false

fn check_cheats()
    U pressed = pads[0].pressed
    if pressed != 0
        cheat_timer = 0
        
        // Konami Code
        CCC/game kcode = @konami_code
        if pressed == kcode[cheat_index]
            cheat_index += 1
            if cheat_index == 10
                cheat_index = 0
                cheat_shake_timer = 60 // Shake for 1 second
                if game_mode == GAME_MODE_NORMAL
                    game_mode = GAME_MODE_KONAMI
                    p.health = 5
                else
                    game_mode = GAME_MODE_NORMAL
                    p.health = 7
        else
            if pressed == kcode[0]
                cheat_index = 1
            else
                cheat_index = 0

        // Level Cheat (B A B A + Direction)
        CCC/game lcode = @level_cheat_code
        if level_cheat_index < 4
            if pressed == lcode[level_cheat_index]
                level_cheat_index += 1
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0
        else
            if pressed == BUTTON_RIGHT
                // Next level
                level_cheat_index = 0
                cheat_shake_timer = 30
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                p.is_initialised = false
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
                p.health = 7
            else if pressed == BUTTON_LEFT
                // Previous level
                level_cheat_index = 0
                cheat_shake_timer = 30
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                p.is_initialised = false
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
                p.health = 7
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0

        // "Shift" shortcuts (SELECT + Right/Left)
        if (pads[0].held & BUTTON_SELECT)
            if pressed == BUTTON_RIGHT
                cheat_shake_timer = 30
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                p.is_initialised = false
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
                p.health = 7
            else if pressed == BUTTON_LEFT
                cheat_shake_timer = 30
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                p.is_initialised = false
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
                p.health = 7
    else
        cheat_timer += 1
        if cheat_timer > 120
            cheat_index = 0
            level_cheat_index = 0
            cheat_timer = 0
    
    if cheat_shake_timer > 0
        cheat_shake_timer -= 1
