/*
 * BlasNESmous - game_over
 */

fn game_over_init()
    // game_over initialization logic here

fn game_over_main()
    // game_over main logic here

fn game_over_sprites(U o) U
    hide_oam(0)
    return 64

mode game_over(U level_index)
: nmi game_nmi
    current_level_index = level_index
    game_state = GAME_STATE_GAME_OVER

    // Load level
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    load_level(levels[current_level_index])
    load_level_finish()

    // NMI ON
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_NT_2000)
    {PPUMASK}(PPUMASK_BG_ON | PPUMASK_NO_CLIP)

    is_start_pressed = false

    while true
        nmi
        ppu_upload_oam_poll_pads(0)
        update_pads()
        is_select_pressed = false

        if is_start_pressed
            is_start_pressed = false
            game_state = GAME_STATE_TITLE
            goto mode main()
            : preserves /game
