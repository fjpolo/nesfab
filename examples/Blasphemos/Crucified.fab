ct U CRUCIFIED_STATE_IDLE = 0
ct U CRUCIFIED_STATE_ATTACK = 1

struct Crucified
    SS x
    SS y
    Bool facing_left
    U attack_timer
    U health
    U hurt_timer
    U blocked_timer
    U local_index
    U ai_state


vars /enemies
    AnimState[4] crucified_anim_state

vars /patrol
    SS[4] crucified_patrol_center
    U[4] crucified_patrol_dir

data /sprites
    [] sprite_crucified_idle
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms(0,  -32, $C1, $01), Ms( 0, -23, $C2, $01), 
            Ms(-8, -24, $D0, $01), Ms( 0, -24, $D1, $01), Ms( 8, -24, $D2, $01), 
            Ms(-8, -16, $E0, $01), Ms( 0, -16, $E1, $01), Ms( 8, -16, $E2, $01), Ms( 16, -16, $E3, $01),
            Ms(-8, -8,  $F0, $01), Ms( 0, -8,  $F1, $01), Ms( 8, -8,  $F2, $01), Ms( 16, -8, $F3, $01), Ms( 24, -8, $F4, $01)
        )))

    [] sprite_crucified_idle_left
        (make_metasprite(0, Ms{}(
            Ms(0,  -32, $C1, $01), Ms( 0, -23, $C2, $01), 
            Ms(-8, -24, $D0, $01), Ms( 0, -24, $D1, $01), Ms( 8, -24, $D2, $01), 
            Ms(-8, -16, $E0, $01), Ms( 0, -16, $E1, $01), Ms( 8, -16, $E2, $01), Ms( 16, -16, $E3, $01),
            Ms(-8, -8,  $F0, $01), Ms( 0, -8,  $F1, $01), Ms( 8, -8,  $F2, $01), Ms( 16, -8, $F3, $01), Ms( 24, -8, $F4, $01)
        )))

    [] sprite_crucified_attack
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms(0,  -32, $C1, $01), Ms( 0, -23, $C2, $01), 
            Ms(-8, -24, $D0, $01), Ms( 0, -24, $D1, $01), Ms( 8, -24, $D2, $01), 
            Ms(-8, -16, $E0, $01), Ms( 0, -16, $E1, $01), Ms( 8, -16, $E2, $01), Ms( 16, -16, $E3, $01),
            Ms(-8, -8,  $F0, $01), Ms( 0, -8,  $F1, $01), Ms( 8, -8,  $F2, $01), Ms( 16, -8, $F3, $01), Ms( 24, -8, $F4, $01)
        )))

    [] sprite_crucified_attack_left
        (make_metasprite(0, Ms{}(
            Ms(0,  -32, $C1, $01), Ms( 0, -23, $C2, $01), 
            Ms(-8, -24, $D0, $01), Ms( 0, -24, $D1, $01), Ms( 8, -24, $D2, $01), 
            Ms(-8, -16, $E0, $01), Ms( 0, -16, $E1, $01), Ms( 8, -16, $E2, $01), Ms( 16, -16, $E3, $01),
            Ms(-8, -8,  $F0, $01), Ms( 0, -8,  $F1, $01), Ms( 8, -8,  $F2, $01), Ms( 16, -8, $F3, $01), Ms( 24, -8, $F4, $01)
        )))

    [] crucified_animation_standing
        (make_anim(Fs{}(
            Fs(1, @sprite_crucified_idle)
        )))

    [] crucified_animation_standing_left
        (make_anim(Fs{}(
            Fs(1, @sprite_crucified_idle_left)
        )))
    
    [] crucified_animation_attack
        (make_anim(Fs{}(
            Fs(150, @sprite_crucified_idle_left),
            Fs(60, @sprite_crucified_idle)
        )))

    [] crucified_animation_attack_left
        (make_anim(Fs{}(
            Fs(150, @sprite_crucified_idle),
            Fs(60, @sprite_crucified_idle_left)
        )))

fn crucified_delete_with_patrol(U ix)
    crucifieds_delete(ix)
    if ix < crucifieds_num
        crucified_patrol_center[ix] = crucified_patrol_center[crucifieds_num]
        crucified_patrol_dir[ix] = crucified_patrol_dir[crucifieds_num]

fn crucified_update(U ix) Bool
    SS ex = crucifieds[ix].x
    SS ey = crucifieds[ix].y

    // Only update if enemy is on screen
    if ex < (p.camera_x - 16) || ex > (p.camera_x + 272)
        return true

    // Gravity check
    U ground_tile = collision_at(UU(ex), UU(ey))
    if ground_tile != C_WALL && ground_tile != C_PLATFORM && ground_tile != C_JAIL
        crucifieds[ix].y += 2
        // Snap to floor if we landed
        U landed_tile = collision_at(UU(ex), UU(crucifieds[ix].y))
        if landed_tile == C_WALL || landed_tile == C_PLATFORM || landed_tile == C_JAIL
            crucifieds[ix].y = crucifieds[ix].y & -16
        ey = crucifieds[ix].y // refresh local copy of ey

    // Out of bounds check: delete if fallen into bottomless pit
    if ey > (SS(current_level_height) << 4)
        crucified_delete_with_patrol(ix)
        return false

    // Patrol: move 1px every 4 frames (veeery slow), flip on wall or 1-tile boundary (16px)
    if crucifieds[ix].ai_state == CRUCIFIED_STATE_IDLE && crucifieds[ix].blocked_timer == 0
        if (frame_counter & 3) == 0  // move every 4 frames = very slow
            SS center = crucified_patrol_center[ix]
            U dir = crucified_patrol_dir[ix]
            if dir == 1  // moving left
                crucifieds[ix].x -= 1
                U check_wall = collision_at(UU(crucifieds[ix].x - 8), UU(ey - 8))
                U check_floor = collision_at(UU(crucifieds[ix].x - 8), UU(ey))
                if check_wall == C_WALL
                    dir = 0
                else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                    dir = 0
                else if crucifieds[ix].x <= (center - SS(16)) // 1-tile boundary
                    dir = 0
            else                            // moving right
                crucifieds[ix].x += 1
                U check_wall = collision_at(UU(crucifieds[ix].x + 8), UU(ey - 8))
                U check_floor = collision_at(UU(crucifieds[ix].x + 8), UU(ey))
                if check_wall == C_WALL
                    dir = 1
                else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                    dir = 1
                else if crucifieds[ix].x >= (center + SS(16)) // 1-tile boundary
                    dir = 1
            crucified_patrol_dir[ix] = dir
            ex = crucifieds[ix].x  // refresh local copy after moving
    
    // Facing logic: Face player if within 100 pixels
    SS dist_x = p.center_x - (ex + 12) // Crucified center is approx ex + 12
    if dist_x < 0
        dist_x = -dist_x
    SS dist_y = p.center_y - (ey - 16) // Crucified center is approx ey - 16
    if dist_y < 0
        dist_y = -dist_y

    if dist_x < 100 && dist_y < 100
        if p.x < ex
            crucifieds[ix].facing_left = true
        else
            crucifieds[ix].facing_left = false
    else
        crucifieds[ix].facing_left = (crucified_patrol_dir[ix] == 1)

    if crucifieds[ix].hurt_timer > 0
        crucifieds[ix].hurt_timer -= 1

    if crucifieds[ix].blocked_timer > 0
        crucifieds[ix].blocked_timer -= 1
        crucifieds[ix].attack_timer = 0 // Stay idle while blocked
        crucifieds[ix].ai_state = CRUCIFIED_STATE_IDLE

    // Player hit Pilgrim (Hitbox logic)
    if player_sword_active
        SS sx = player_sword_x
        SS sy = player_sword_y
        // Body bounds: (ex-4, ey-16) to (ex+12, ey)
        if sx < (ex + 12) && (sx + player_sword_w) > (ex - 4) && sy < ey && (sy + player_sword_h) > (ey - 16)
             Bool is_combo = register_sword_hit()
             if crucifieds[ix].hurt_timer == 0
                 crucifieds[ix].hurt_timer = 30 // I-frames
                 player_pogo()
                 U power = p.attack_power
                 if is_combo
                     power = power << 1 // Double damage on combo hit!
                 if crucifieds[ix].blocked_timer > 0
                     power = power << 1 // Double damage when blocked
                 
                 if crucifieds[ix].health > power
                     crucifieds[ix].health -= power
                 else
                      crucifieds[ix].health = 0
                      U global_ix = (current_level_index << 3) + crucifieds[ix].local_index
                      U byte_ix = global_ix >> 3
                      U bit_ix = global_ix & 7
                      dead_pilgrims[byte_ix] |= (U(1) << bit_ix)
                      crucified_delete_with_patrol(ix)
                      return false

    // State machine logic
    switch crucifieds[ix].ai_state
        case CRUCIFIED_STATE_IDLE
            if crucifieds[ix].blocked_timer == 0
                if dist_x < 40 && dist_y < 40 // 2.5 tiles away
                    crucifieds[ix].ai_state = CRUCIFIED_STATE_ATTACK
                    crucifieds[ix].attack_timer = 0
            break

        case CRUCIFIED_STATE_ATTACK
            crucifieds[ix].attack_timer += 1
            if crucifieds[ix].attack_timer >= 210 // 3.5 seconds
                crucifieds[ix].ai_state = CRUCIFIED_STATE_IDLE
                crucifieds[ix].attack_timer = 0

            // Proper attack lasts 1 second (final 60 frames of cycle, when it flips)
            if crucifieds[ix].attack_timer > 150
                SS swx
                if crucifieds[ix].facing_left
                    swx = ex - 24
                else
                    swx = ex - 8
                SS swy = ey - 24 // Lowered origin for taller box
                SS sww = 32
                SS swh = 32 // Large 32x32 hit area for the swing
                
                // Hit window starts slightly before the visual flip to ensure it feels responsive
                if crucifieds[ix].attack_timer >= 145 && crucifieds[ix].attack_timer < 180
                    if p.hitbox_x < (swx + sww) && (p.hitbox_x + p.w) > swx && SS(p.y) < (swy + swh) && (SS(p.y) + p.h) > swy
                        if hurt_player(ATTACK_CRUCIFIED, ex)
                            crucifieds[ix].blocked_timer = 120
                            crucifieds[ix].ai_state = CRUCIFIED_STATE_IDLE
                            crucifieds[ix].attack_timer = 0
            break

    // Animation selection
    CCC/sprites anim_to_set
    if crucifieds[ix].ai_state == CRUCIFIED_STATE_ATTACK
        if crucifieds[ix].facing_left
            anim_to_set = @crucified_animation_attack_left
        else
            anim_to_set = @crucified_animation_attack
    else
        if crucifieds[ix].facing_left
            anim_to_set = @crucified_animation_standing_left
        else
            anim_to_set = @crucified_animation_standing
            
    if UU(crucified_anim_state[ix].frames) != UU(anim_to_set)
        crucified_anim_state[ix] = make_anim_state(anim_to_set)

    // Basic collision with player (contact damage)
    if p.hitbox_x < (ex + 12) && (p.hitbox_x + p.w) > (ex - 4) && SS(p.y) < SS(ey) && (SS(p.y) + p.h) > (ey - 16)
        if hurt_player(ATTACK_CRUCIFIED, ex)
            crucifieds[ix].blocked_timer = 120
            crucifieds[ix].ai_state = CRUCIFIED_STATE_IDLE
            crucifieds[ix].attack_timer = 0
    
    return true

fn draw_crucifieds(U o) U
    if crucifieds_num == 0
        return o
        
    U start = frame_counter & 7
    if start >= crucifieds_num
        start = 0
    for U j = 0; j < crucifieds_num; j += 1
        U i = start + j
        if i >= crucifieds_num
            i -= crucifieds_num
            
        if crucified_update(i)
            SS x = SS(crucifieds[i].x) - p.camera_x
            SS y = crucifieds[i].y
            if crucifieds[i].hurt_timer > 0
                o = push_oam_anim_a(o, x, y, crucified_anim_state[i], $02) // White flash
            else if crucifieds[i].blocked_timer > 0
                o = push_oam_anim_a(o, x, y, crucified_anim_state[i], $03) // Original red/tint
            else
                o = push_oam_anim(o, x, y, crucified_anim_state[i])
    return o
