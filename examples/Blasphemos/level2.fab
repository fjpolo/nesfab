/*
 * BlasNESmous - Level 2
 * Prie Dieu Altar Logic
 */

fn level2_init()
    // Level 2 initialization logic here
    // SPR1 palette: ($2D, $17, $32)
    palette[15] = $2D
    palette[16] = $17
    palette[17] = $32
    ppu_upload_palette()

fn level2_main()
    // Altar hit detection (moved from player.fab)
    if current_level_index == LEVEL_L2 && p.movement == PLAYER_MOVING_ATTACK
        if player_sword_x < 132 && (player_sword_x + player_sword_w) > 116
             if !prie_dieu_lit || last_prie_dieu_level != LEVEL_L2
                 prie_dieu_lit = true
                 last_prie_dieu_level = current_level_index
                 last_prie_dieu_x = p.x
                 last_prie_dieu_y = SS(p.y)
                 log(@"Prie Dieu lit!"l)
             
             p.health = U(PLAYER_MAX_HEALTH)
             p.current_bile_vessels = p.max_bile_vessels

fn draw_level2_sprites(U o) U
    // Bring back the candles after hitting the prie dieu
    // But make the candles disappear when they are no longer seen because of scrolling
    if current_level_index == LEVEL_L2 && prie_dieu_lit && last_prie_dieu_level == LEVEL_L2
        SS ax = 124 - p.camera_x
        // Check if onscreen (with some margin for 8px wide tiles)
        if ax > -16 && ax < 256
            // Draw candles using tiles $0E, $0F with palette 1 (SPR1)
            set_oam(o, U(ax - 4), 199, $0E, 1)
            o += 4
            set_oam(o, U(ax + 4), 199, $0F, 1)
            o += 4
    return o
