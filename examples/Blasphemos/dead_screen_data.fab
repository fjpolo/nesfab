// Dead screen palette constants from assets/dead_Screen.nss

// Dead CHR bank index (MMC3 bank 27)
ct U DEAD_CHR_BANK = 27

// Load the raw dead screen CHR tiles into MMC3 bank 27 (BG slot, $0000-$1FFF)
chrrom (27 * $2000)
    file(raw, "assets/dead_screen_CHR.chr")

// Universal Background Color
ct U DEAD_UBC = $0F

// BG sub-palette colors (3 colors per palette x 4 palettes = 12 values)
ct U[12] dead_bg_palette = U[12](
    // Palette 0:  $15, $16, $07
    $15, $16, $07,
    // Palette 1:  $00, $32, $00
    $00, $32, $00,
    // Palette 2:  $0C, $30, $0F
    $0C, $30, $0F,
    // Palette 3:  $0F, $0F, $0F
    $0F, $0F, $0F
)

// Nametable + attributes loaded from binary .nam file
data /dead
    [] dead_nam
        file(raw, "assets/dead_screen.nam")
