struct ItemBone
    SS x
    SS y
    Bool collected

vars /items
    AnimState[8] item_bone_anim_state

vars /game
    Bool[64] item_bones_collected_flags

data /sprites
    [] sprite_item_bone
        (make_metasprite(0, Ms{}(
            Ms(0, -8, $1F, $01)
        )))

    [] item_bone_animation
        (make_anim(Fs{}(
            Fs(1, @sprite_item_bone)
        )))

fn item_bone_update(U ix) Bool
    if item_bones[ix].collected
        return false

    SS ex = item_bones[ix].x
    SS ey = item_bones[ix].y
    
    // Sword collision only
    if player_sword_active
        if player_sword_x < (ex + 8) && (player_sword_x + player_sword_w) > (ex - 8)
            if player_sword_y < (ey) && (player_sword_y + player_sword_h) > (ey - 16)
                item_bones[ix].collected = true
                U global_ix = (U(current_level_index) << 3) + ix
                if global_ix < 64
                    item_bones_collected_flags[global_ix] = true
                return false

    return true

fn draw_item_bones(U o) U
    if item_bones_num == 0
        return o
        
    U start = frame_counter & 7
    if start >= item_bones_num
        start = 0
    for U j = 0; j < item_bones_num; j += 1
        U i = start + j
        if i >= item_bones_num
            i -= item_bones_num
            
        if item_bone_update(i)
            SS x = item_bones[i].x - p.camera_x
            SS y = item_bones[i].y
            o = push_oam_anim(o, x, y, item_bone_anim_state[i])
    return o
