// Load the .json file, calling the macros for each definition.
mapfab(raw, "blasnesmous.json", "chr", "palette", "metatiles", "level")

macro("pool_contiguous", "Enemy_eye", "4", "enemies_eye", "/game")
macro("pool_contiguous", "Enemy_following_eye", "4", "enemies_following_eye", "/game")
macro("pool_contiguous", "EnragedPilgrim", "4", "enraged_pilgrims", "/game")
macro("pool_contiguous", "Crucified", "4", "crucifieds", "/game")
macro("pool_contiguous", "ItemBone", "8", "item_bones", "/game")

// Used in level.macrofab to format the enemies:
ct fn enemies_eye_vec(Int{} x, Int{} y) Enemy_eye{}
    Enemy_eye{} out = Enemy_eye{}()
    for UU i = 0; i < len(x); i += 1
        push(out, Enemy_eye(U(x{i}), U(y{i}), 0))
    return out

// Used in level.macrofab to format the enemies:
ct fn enemies_following_eye_vec(Int{} x, Int{} y) Enemy_following_eye{}
    Enemy_following_eye{} out = Enemy_following_eye{}()
    for UU i = 0; i < len(x); i += 1
        push(out, Enemy_following_eye(U(x{i}), U(y{i}), 0))
    return out

// Used in level.macrofab to format the enemies:
ct fn enraged_pilgrims_vec(Int{} x, Int{} y) EnragedPilgrim{}
    EnragedPilgrim{} out = EnragedPilgrim{}()
    for UU i = 0; i < len(x); i += 1
        push(out, EnragedPilgrim(SS(x{i}), SS(y{i}), false, 0, 30, 0, 0, 0))
    return out

// Used in level.macrofab to format the enemies:
ct fn crucifieds_vec(Int{} x, Int{} y) Crucified{}
    Crucified{} out = Crucified{}()
    for UU i = 0; i < len(x); i += 1
        push(out, Crucified(SS(x{i}), SS(y{i}), false, 0, 60, 0, 0, 0, 0))
    return out

// Used in level.macrofab to format the items:
ct fn item_bones_vec(Int{} x, Int{} y) ItemBone{}
    ItemBone{} out = ItemBone{}()
    for UU i = 0; i < len(x); i += 1
        push(out, ItemBone(SS(x{i}), SS(y{i}), false))
    return out

// Tile collision values:
ct U C_OPEN             = 0
ct U C_WALL             = 1
ct U C_COIN             = 2
ct U C_EXIT             = 3
ct U C_LADDER           = 4
ct U C_CEILING_SCALE    = 5
ct U C_KEY              = 6
ct U C_JAIL             = 7
ct U C_PLATFORM         = 8

vars /metatiles
    // Pointers to our metatile data.
    // (This is more useful if we have multiple metatile sets.)
    CC/metatiles mt_nw
    CC/metatiles mt_ne
    CC/metatiles mt_sw
    CC/metatiles mt_se
    CC/metatiles mt_ca

vars /game
    U current_level_index = FIRST_LEVEL_INDEX


vars /levels
    CCC/levels current_level
    CCC/levels current_level_enemies
    U current_level_width
    U current_level_height
    U[256] destroyed = U[256](0)
    

ct CCC/levels[] levels = CCC/levels[](
                                        @lev_title,         // 0
                                        @lev_l1,            // 1
                                        @lev_l2,            // 2
                                        @lev_l3,            // 3
                                        @lev_l4,            // 4
                                        @lev_l4sub1,        // 5
                                        @lev_l5,            // 6
                                        @lev_l6,            // 7
                                        @lev_l7,            // 8
                                        @lev_l7over1,       // 9
                                        @lev_l8,            // 10
                                        @lev_l9,            // 11
                                        @lev_l10,           // 12
                                        @lev_l9sub1,        // 13
                                        @lev_l9over1,       // 14
                                        @lev_l9over2,       // 15
                                        @lev_l10sub1,       // 16
                                        @lev_l8over1,       // 17
                                        @lev_game_over,     // 18
                                        @lev_l2b,           // 19
                                        @lev_l3b,           // 20
                                        @lev_l6b,           // 21
                                    )
ct U FIRST_LEVEL_INDEX =  1
ct U LAST_LEVEL_INDEX =  21

// Sets the 'mt_' pointers to offsets of 'mt'.
fn load_metatiles(CC/metatiles mt)
    UU size = UU(read U(mt))
    if size == 0
        size = 256
    mt_nw = mt
    mt += size
    mt_ne = mt
    mt += size
    mt_sw = mt
    mt += size
    mt_se = mt
    mt += size
    mt_ca = mt

// Helper function to switch the entire 8KB CHR bank using MMC3
fn select_chr_8kb(U bank)
    U base = bank << 3
    mmc3_select(0, base)     // 2KB at $0000
    mmc3_select(1, base + 2) // 2KB at $0800
    mmc3_select(2, base + 4) // 1KB at $1000
    mmc3_select(3, base + 5) // 1KB at $1400
    mmc3_select(4, base + 6) // 1KB at $1800
    mmc3_select(5, base + 7) // 1KB at $1C00

fn disable_nmi()
    
fn load_level(CCC/levels level)
    warden_active = false
    player_combo_count = 0
    swing_is_combo_hit = false
    for UU i = 0; i < 256; i += 1
        destroyed[U(i)] = 0
    
    // CHR:
    U chr_bank = read U(level)
    if current_level_index == 7
        chr_bank += 16
    select_chr_8kb(chr_bank)
    current_level_chr = chr_bank

    // Palette:
    load_palette(read CCC/palettes(level))
    // Force HUD Background Palette (Palette 0)
    palette[24] = $0F // Universal background color (Black background for HUD)
    palette[0] = $16 // Brighter red for numbers
    palette[1] = $10 // Light grey for bars
    palette[2] = $30 // White for highlights

    // Sprite Palette 2 -> RED (for healing flash)
    palette[18] = $25 // Brighter red
    palette[19] = $16 // Brighter red
    palette[20] = $36 // Brighter red
    // Sprite Palette 3 -> WHITE (for highlights/flicker)
    palette[21] = $30
    palette[22] = $30
    palette[23] = $30
    ppu_upload_palette()


    // Metatiles:
    load_metatiles(read CC/metatiles(level))

    // Level tiles:
    current_level_width = read U(level)
    current_level_height = read U(level)
    current_level = read CCC/levels(level)

    // Check if key was grabbed
    // Clear all enemy and item pools to prevent stale data in non-gameplay levels
    enemies_eye_clear()
    clear_following_eye_set_initial_state_level_flag()
    enemies_following_eye_clear()
    enraged_pilgrims_clear()
    crucifieds_clear()
    wheelbrokens_clear()
    item_bones_clear()

    // Check if key was grabbed
    if current_level_index != 255
        // Enemies: Eye
        U eye_num = read U(level)
        for U i = 0; i < eye_num; i += 1
            Enemy_eye e = read Enemy_eye(level)
            e.local_index = i
            U global_ix = (current_level_index << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if (dead_eyes[byte_ix] & (U(1) << bit_ix)) == 0
                enemies_eye_new(e)
                enemies_eye_anim_state[enemies_eye_num - 1] = make_anim_state(@eye_animation)
            
        // Enemies: Following Eye
        U following_eye_num = read U(level)
        for U i = 0; i < following_eye_num; i += 1
            Enemy_following_eye fe = read Enemy_following_eye(level)
            fe.local_index = i
            U global_ix = (current_level_index << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if (dead_following_eyes[byte_ix] & (U(1) << bit_ix)) == 0
                enemies_following_eye_new(fe)
                U new_idx = enemies_following_eye_num - 1
                current_level_enemies = current_level
                following_eye_set_initial_state_current_level_flag = true
                following_eye_set_initial_state(new_idx, enemies_following_eye[new_idx].x, enemies_following_eye[new_idx].y)

        // Enemies: Enraged Pilgrim
        U pilgrim_num = read U(level)
        for U i = 0; i < pilgrim_num; i += 1
            EnragedPilgrim ep = read EnragedPilgrim(level)
            ep.local_index = i
            U global_ix = (current_level_index << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if (dead_pilgrims[byte_ix] & (U(1) << bit_ix)) == 0
                enraged_pilgrims_new(ep)
                enraged_pilgrim_anim_state[enraged_pilgrims_num - 1] = make_anim_state(@enraged_pilgrim_animation_standing)

        // Enemies: Crucified
        U crucified_num = read U(level)
        for U i = 0; i < crucified_num; i += 1
            Crucified c = read Crucified(level)
            c.local_index = i
            U global_ix = (current_level_index << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if (dead_crucifieds[byte_ix] & (U(1) << bit_ix)) == 0
                crucifieds_new(c)
                crucified_anim_state[crucifieds_num - 1] = make_anim_state(@crucified_animation_standing)

        // Enemies: Wheelbroken
        U wheel_num = read U(level)
        for U i = 0; i < wheel_num; i += 1
            Wheelbroken wb = read Wheelbroken(level)
            wb.local_index = i
            U global_ix = (current_level_index << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if (dead_wheelbrokens[byte_ix] & (U(1) << bit_ix)) == 0
                wheelbrokens_new(wb)
                wheelbroken_anim_state[wheelbrokens_num - 1] = make_anim_state(@wheelbroken_animation_standing)

        // Items: Bone
        U bone_num = read U(level)
        for U i = 0; i < bone_num; i += 1
            item_bones_new(read ItemBone(level))
            U global_ix = (U(current_level_index) << 3) + i
            U byte_ix = global_ix >> 3
            U bit_ix = global_ix & 7
            if byte_ix < 20 && (item_bones_collected_flags[byte_ix] & (U(1) << bit_ix)) != 0
                item_bones[i].collected = true
            item_bone_anim_state[i] = make_anim_state(@item_bone_animation)

        if !show_key[current_level_index]
            if collision_at(key_x[current_level_index], key_y[current_level_index]) == C_KEY
                destroy(key_x[current_level_index], key_y[current_level_index])
    else
        // Just skip enemy/item data for non-standard levels (like Map)
        U eye_num = read U(level)
        for U i = 0; i < eye_num; i += 1
            read Enemy_eye(level)
        U following_eye_num = read U(level)
        for U i = 0; i < following_eye_num; i += 1
            read Enemy_following_eye(level)
        U pilgrim_num = read U(level)
        for U i = 0; i < pilgrim_num; i += 1
            read EnragedPilgrim(level)
        U crucified_num = read U(level)
        for U i = 0; i < crucified_num; i += 1
            read Crucified(level)
        U wheel_num = read U(level)
        for U i = 0; i < wheel_num; i += 1
            read Wheelbroken(level)
        U bone_num = read U(level)
        for U i = 0; i < bone_num; i += 1
            read ItemBone(level)
    if current_level_index == 1
        level1_init()
    else if current_level_index == 2 || current_level_index == 19
        level2_init()
    else if current_level_index == 4
        level4_init()
    else if current_level_index == 5
        level4sub1_init()
    else if current_level_index == 7
        level6_init()
    else if current_level_index == 8
        level7_init()
    else if current_level_index == 9
        level7over1_init()
    else if current_level_index == 10
        level8_init()
    else if current_level_index == 11
        level9_init()
    else if current_level_index == 12
        level10_init()
    else if current_level_index == 13
        level9sub1_init()
    else if current_level_index == 14
        level9over1_init()
    else if current_level_index == 15
        level9over2_init()
    else if current_level_index == 16
        level10sub1_init()
    else if current_level_index == 17
        level8over1_init()
    else if current_level_index == 18
        game_over_init()

    if game_mode == GAME_MODE_KONAMI
        for U i = 0; i < enraged_pilgrims_num; i += 1
            enraged_pilgrims[i].health = 60
        for U i = 0; i < wheelbrokens_num; i += 1
            wheelbrokens[i].health = 80
        if current_level_index == 1
            warden_health = 255 // Double Warden health (capped at 255)
    
    switch current_level_index
        case 3
            if keys[current_level_index]
                // remove door
                if collision_at(LEVEL_3_DOOR_0_X, LEVEL_3_DOOR_0_Y) == C_JAIL
                    destroy(LEVEL_3_DOOR_0_X, LEVEL_3_DOOR_0_Y)
                if collision_at(LEVEL_3_DOOR_1_X, LEVEL_3_DOOR_1_Y) == C_JAIL
                    destroy(LEVEL_3_DOOR_1_X, LEVEL_3_DOOR_1_Y)
        break

    load_level_counter += 1

fn load_level_finish()
    // Set the scroll off-screen, then run the scroll code several times
    // to fill the screen with tiles.
    scroll_x = calc_shifted_camera_x() + 32
    while true
        update_scroll()
        ppu_upload_scroll()
        if scroll_x == calc_shifted_camera_x()
            break

