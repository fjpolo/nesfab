struct EnragedPilgrim
    SS x
    SS y
    Bool facing_left
    U attack_timer
    U health
    U hurt_timer
    U blocked_timer
    U local_index
    SS patrol_center 
    Bool patrol_dir


ct Int PILGRIM_HP = 30
ct Int PILGRIM_DETECTION_RANGE = 100
ct Int PILGRIM_ATTACK_RANGE_X = 64
ct Int PILGRIM_ATTACK_RANGE_Y = 40
ct Int PILGRIM_ATTACK_DURATION = 30
ct Int PILGRIM_ATTACK_COOLDOWN = 180
ct Int PILGRIM_BLOCKED_DURATION = 120
ct Int PILGRIM_HURT_DURATION = 30

ct Int PILGRIM_HITBOX_W = 16
ct Int PILGRIM_HITBOX_H = 16
ct Int PILGRIM_HITBOX_OFF_X = -12
ct Int PILGRIM_HITBOX_OFF_Y = -16

ct Int PILGRIM_SWORD_W = 24
ct Int PILGRIM_SWORD_H = 16
ct Int PILGRIM_SWORD_OFF_X_RIGHT = 0
ct Int PILGRIM_SWORD_OFF_X_LEFT = -24
ct Int PILGRIM_SWORD_OFF_Y = -16

vars /enemies
    AnimState[4] enraged_pilgrim_anim_state

data /sprites
    [] sprite_enraged_pilgrim_standing
        (make_metasprite(0, Ms{}(
            Ms(-8,-24, $D0, $01), Ms( 0,-24, $D1, $01), 
            Ms(-8,-16, $E0, $01), Ms( 0,-16, $E1, $01), 
            Ms(-8, -8, $F0, $01), Ms( 0, -8, $F1, $01)
        )))

    [] sprite_enraged_pilgrim_standing_left
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms(-8,-24, $D0, $01), Ms( 0,-24, $D1, $01), 
            Ms(-8,-16, $E0, $01), Ms( 0,-16, $E1, $01), 
            Ms(-8, -8, $F0, $01), Ms( 0, -8, $F1, $01)
        )))

    [] sprite_enraged_pilgrim_standing_attack
        (make_metasprite(0, Ms{}(
            Ms(-8,-24, $D0, $01), Ms( 0,-24, $D1, $01), 
            Ms(-8,-16, $E0, $01), Ms( 0,-16, $E1, $01), Ms( 8,-16, $E2, $01), 
            Ms(-8, -8, $F0, $01), Ms( 0, -8, $F1, $01)
        )))

    [] sprite_enraged_pilgrim_standing_attack_left
        (make_metasprite(ATTR_H_FLIP, Ms{}(
            Ms(-8,-24, $D0, $01), Ms( 0,-24, $D1, $01), 
            Ms(-8,-16, $E0, $01), Ms( 0,-16, $E1, $01), Ms( 8,-16, $E2, $01), 
            Ms(-8, -8, $F0, $01), Ms( 0, -8, $F1, $01)
        )))

    [] enraged_pilgrim_animation_standing
        (make_anim(Fs{}(
            Fs(1, @sprite_enraged_pilgrim_standing)
        )))

    [] enraged_pilgrim_animation_standing_left
        (make_anim(Fs{}(
            Fs(1, @sprite_enraged_pilgrim_standing_left)
        )))
    
    [] enraged_pilgrim_animation_attack
        (make_anim(Fs{}(
            Fs(1, @sprite_enraged_pilgrim_standing_attack)
        )))

    [] enraged_pilgrim_animation_attack_left
        (make_anim(Fs{}(
            Fs(1, @sprite_enraged_pilgrim_standing_attack_left)
        )))

fn enraged_pilgrim_update(U ix) Bool
    SS ex = enraged_pilgrims[ix].x
    SS ey = enraged_pilgrims[ix].y

    // Only update if enemy is on screen
    if ex < (p.camera_x - 16) || ex > (p.camera_x + 272)
        return true

    // Gravity check (optimized to run once every 4 frames)
    if (frame_counter & 3) == (ix & 3)
        U ground_tile = collision_at(UU(ex), UU(ey))
        if ground_tile != C_WALL && ground_tile != C_PLATFORM && ground_tile != C_JAIL
            enraged_pilgrims[ix].y += 8 // 2px per frame * 4 frames
            // Snap to floor if we landed
            U landed_tile = collision_at(UU(ex), UU(enraged_pilgrims[ix].y))
            if landed_tile == C_WALL || landed_tile == C_PLATFORM || landed_tile == C_JAIL
                enraged_pilgrims[ix].y = enraged_pilgrims[ix].y & -16
            ey = enraged_pilgrims[ix].y // refresh local copy of ey

    // Out of bounds check: delete if fallen into bottomless pit
    if ey > (SS(current_level_height) << 4)
        enraged_pilgrims_delete(ix)
        return false

    // Patrol: move every other frame, flip on wall or 2-tile boundary
    if enraged_pilgrims[ix].blocked_timer == 0
        if (frame_counter & 1) == 0
            if enraged_pilgrims[ix].patrol_dir  // moving left
                enraged_pilgrims[ix].x -= 1
            else                                // moving right
                enraged_pilgrims[ix].x += 1
            ex = enraged_pilgrims[ix].x  // refresh local copy after moving

        // Flip checks: check wall/pit modulo 4 frames
        if (frame_counter & 3) == (ix & 3)
            if enraged_pilgrims[ix].patrol_dir  // moving left
                if ex <= 8
                    enraged_pilgrims[ix].patrol_dir = false
                else
                    U check_wall = collision_at(UU(ex - 8), UU(ey - 8))
                    U check_floor = collision_at(UU(ex - 8), UU(ey))
                    if check_wall == C_WALL
                        enraged_pilgrims[ix].patrol_dir = false
                    else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                        enraged_pilgrims[ix].patrol_dir = false
            else                                // moving right
                if ex >= (SS(current_level_width) << 4) - 8
                    enraged_pilgrims[ix].patrol_dir = true
                else
                    U check_wall = collision_at(UU(ex + 8), UU(ey - 8))
                    U check_floor = collision_at(UU(ex + 8), UU(ey))
                    if check_wall == C_WALL
                        enraged_pilgrims[ix].patrol_dir = true
                    else if check_floor != C_WALL && check_floor != C_PLATFORM && check_floor != C_JAIL
                        enraged_pilgrims[ix].patrol_dir = true

        // Patrol bounds checks: check every frame to prevent boundary overshoot
        if enraged_pilgrims[ix].patrol_dir
            if ex <= (enraged_pilgrims[ix].patrol_center - SS(32))
                enraged_pilgrims[ix].patrol_dir = false
        else
            if ex >= (enraged_pilgrims[ix].patrol_center + SS(32))
                enraged_pilgrims[ix].patrol_dir = true

    // Facing logic: Face player if within 100 pixels
    SS dist_x = p.x - ex
    if dist_x < 0
        dist_x = -dist_x
    SS dist_y = SS(p.y) - ey
    if dist_y < 0
        dist_y = -dist_y

    if dist_x < 100 && dist_y < 100
        if p.x < ex
            enraged_pilgrims[ix].facing_left = true
        else
            enraged_pilgrims[ix].facing_left = false
    else
        // Outside detection range: face the patrol direction
        enraged_pilgrims[ix].facing_left = enraged_pilgrims[ix].patrol_dir

    if enraged_pilgrims[ix].hurt_timer > 0
        enraged_pilgrims[ix].hurt_timer -= 1

    if enraged_pilgrims[ix].blocked_timer > 0
        enraged_pilgrims[ix].blocked_timer -= 1
        enraged_pilgrims[ix].attack_timer = 0 // Stay idle while blocked

    // Player hit Pilgrim (Hitbox logic)
    if player_sword_active
        SS sx = player_sword_x
        SS sy = player_sword_y
        // Body bounds: (ex-12, ey-16) to (ex+4, ey)
        if sx < (ex + (PILGRIM_HITBOX_OFF_X + PILGRIM_HITBOX_W)) && (sx + player_sword_w) > (ex + PILGRIM_HITBOX_OFF_X) && sy < ey && (sy + player_sword_h) > (ey + PILGRIM_HITBOX_OFF_Y)
             Bool is_combo = register_sword_hit()
             if enraged_pilgrims[ix].hurt_timer == 0
                 enraged_pilgrims[ix].hurt_timer = PILGRIM_HURT_DURATION // I-frames
                 player_pogo()
                 U power = p.attack_power
                 if is_combo
                     power = power << 1 // Double damage on combo hit!
                 if enraged_pilgrims[ix].blocked_timer > 0
                     power = power << 1 // Double damage when blocked
                 
                 if enraged_pilgrims[ix].health > power
                     enraged_pilgrims[ix].health -= power
                 else
                      enraged_pilgrims[ix].health = 0
                      U global_ix = (current_level_index << 4) + enraged_pilgrims[ix].local_index
                      U byte_ix = global_ix >> 3
                      U bit_ix = global_ix & 7
                      dead_enemies[byte_ix] |= (U(1) << bit_ix)
                      total_tears_collected += UU(PILGRIM_TEARS_REWARD)
                      enraged_pilgrims_delete(ix)
                      return false

    if enraged_pilgrims[ix].blocked_timer == 0
        if enraged_pilgrims[ix].attack_timer == 0
            if dist_x < PILGRIM_ATTACK_RANGE_X && dist_y < PILGRIM_ATTACK_RANGE_Y
                enraged_pilgrims[ix].attack_timer = 1
        else
            enraged_pilgrims[ix].attack_timer += 1
            if enraged_pilgrims[ix].attack_timer >= PILGRIM_ATTACK_COOLDOWN
                enraged_pilgrims[ix].attack_timer = 0

            // Only check sword collision when the sword is visually out (attack_timer < 30)
            if enraged_pilgrims[ix].attack_timer < PILGRIM_ATTACK_DURATION
                SS swx
                if enraged_pilgrims[ix].facing_left
                    swx = ex + PILGRIM_SWORD_OFF_X_LEFT
                else
                    swx = ex + PILGRIM_SWORD_OFF_X_RIGHT
                SS swy = ey + PILGRIM_SWORD_OFF_Y
                SS sww = PILGRIM_SWORD_W
                SS swh = PILGRIM_SWORD_H
                
                // Check collision with player using a more precise area
                if p.hitbox_x < (swx + sww) && (p.hitbox_x + p.w) > swx && SS(p.y) < (swy + swh) && (SS(p.y) + p.h) > swy
                    if hurt_player(ATTACK_PILGRIM, ex)
                        enraged_pilgrims[ix].blocked_timer = PILGRIM_BLOCKED_DURATION
                        enraged_pilgrims[ix].attack_timer = 0

    // Animation selection
    if enraged_pilgrims[ix].attack_timer < PILGRIM_ATTACK_DURATION // Show attack frame for 0.5s
        if enraged_pilgrims[ix].facing_left
            enraged_pilgrim_anim_state[ix] = make_anim_state(@enraged_pilgrim_animation_attack_left)
        else
            enraged_pilgrim_anim_state[ix] = make_anim_state(@enraged_pilgrim_animation_attack)
    else
        if enraged_pilgrims[ix].facing_left
            enraged_pilgrim_anim_state[ix] = make_anim_state(@enraged_pilgrim_animation_standing_left)
        else
            enraged_pilgrim_anim_state[ix] = make_anim_state(@enraged_pilgrim_animation_standing)

    // Basic collision with player (contact damage)
    if p.hitbox_x < (ex + (PILGRIM_HITBOX_OFF_X + PILGRIM_HITBOX_W)) && (p.hitbox_x + p.w) > (ex + PILGRIM_HITBOX_OFF_X) && SS(p.y) < SS(ey) && (SS(p.y) + p.h) > (ey + PILGRIM_HITBOX_OFF_Y)
        if hurt_player(ATTACK_PILGRIM, ex)
            enraged_pilgrims[ix].blocked_timer = PILGRIM_BLOCKED_DURATION
            enraged_pilgrims[ix].attack_timer = 0
    
    return true

fn draw_enraged_pilgrims(U o) U
    if enraged_pilgrims_num == 0
        return o
        
    U start = frame_counter & 7
    if start >= enraged_pilgrims_num
        start = 0
    for U j = 0; j < enraged_pilgrims_num; j += 1
        U i = start + j
        if i >= enraged_pilgrims_num
            i -= enraged_pilgrims_num
            
        if enraged_pilgrim_update(i)
            SS x = SS(enraged_pilgrims[i].x) - p.camera_x
            SS y = enraged_pilgrims[i].y
            if enraged_pilgrims[i].hurt_timer > 0
                o = push_oam_anim_a(o, x, y, enraged_pilgrim_anim_state[i], $02) // White flash
            else if enraged_pilgrims[i].blocked_timer > 0
                o = push_oam_anim_a(o, x, y, enraged_pilgrim_anim_state[i], $03) // Original red/tint
            else
                o = push_oam_anim(o, x, y, enraged_pilgrim_anim_state[i])
    return o
