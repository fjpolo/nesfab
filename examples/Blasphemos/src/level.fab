// Returns the tile at a pixel position:
fn tile_at(UU pixel_x, UU pixel_y) U
: +inline // Crucial to avoid using JSR and RTS instructions which costs cycles
    if pixel_y.b
        return 0
    if (pixel_y.a >> 4) >= current_level_height
        return 0
    U col = (pixel_x.a >> 4) | (pixel_x.b << 4)
    UU offset = UU(col) << 4
    CCC/levels far_ptr = current_level + offset
    CC/levels near_ptr
    near_ptr.a = far_ptr.a
    near_ptr.b = far_ptr.b
    return near_ptr[pixel_y.a >> 4]

// Returns the collision at a pixel position:
fn collision_at(UU pixel_x, UU pixel_y) U
    U c = mt_ca[tile_at(pixel_x, pixel_y)] >> 2
    if is_jail_at(pixel_x, pixel_y)
        return C_WALL
    if c == C_WALL && current_level_index == 1 && warden_defeated
        // In Warden's arena, make walls walkable after defeat.
        // Arena is roughly from X=352 to X=768.
        if pixel_x > 352 && pixel_x < 768 && pixel_y < 224
            return C_OPEN
    return c
ct fn _destroyed_masks() U[128]
    U[128] masks
    for U i = 0; i < 128; i += 1
        masks[i] = 1 << (i >> 4)
    return masks

// Converts x-positions to bit masks usable with the 'destroyed' bitset array.
ct U[128] destroyed_masks = _destroyed_masks()

// If the tile at a specific position was destroyed or not.
fn destroyed_at(UU pixel_x, UU pixel_y) Bool
    if pixel_y.b
        return true
    U ux = (pixel_x << 1).b & %1111
    U uy = pixel_y.a & %11110000
    U mask = destroyed_masks[pixel_x.a & %1111111]
    return destroyed[ux + uy] & mask

fn destroy(UU pixel_x, UU pixel_y)
    if pixel_y.b
        return
    U ux = (pixel_x << 1).b & %1111
    U uy = pixel_y.a & %11110000
    U mask = destroyed_masks[pixel_x.a & %1111111]
    destroyed[ux + uy] |= mask
    scroll_coin_ppuaddr = calc_scroll_coin_ppuaddr(UU(pixel_x), UU(pixel_y))

    if collision_at(pixel_x, pixel_y) == C_KEY
        // log(@"Key destroyed"l)
        show_key[current_level_index]  = false

fn door_collision_at(UU level_index, UU pixel_x, UU pixel_y) Bool
    if !keys[U(level_index)]
       return C_JAIL == collision_at(pixel_x, pixel_y)
    else
        return false

fn level_update()
    if current_level_index == LEVEL_L1
        level1_main()
    else if current_level_index == LEVEL_L2
        level2_main()
    else if current_level_index == LEVEL_L4
        level4_main()
    else if current_level_index == LEVEL_L4SUB1
        level4sub1_main()
    else if current_level_index == LEVEL_L6 || current_level_index == LEVEL_L6B
        level6_main()
    else if current_level_index == LEVEL_L7
        level7_main()
    else if current_level_index == LEVEL_L7OVER1
        level7over1_main()
    else if current_level_index == LEVEL_L8
        level8_main()
    else if current_level_index == LEVEL_L9
        level9_main()
    else if current_level_index == LEVEL_L10
        level10_main()
    else if current_level_index == LEVEL_L9SUB1
        level9sub1_main()
    else if current_level_index == LEVEL_L9OVER1
        level9over1_main()
    else if current_level_index == LEVEL_L9OVER2
        level9over2_main()
    else if current_level_index == LEVEL_L10SUB1
        level10sub1_main()
    else if current_level_index == LEVEL_L8OVER1
        level8over1_main()
    else if current_level_index == LEVEL_L11
        level11_main()
    else if current_level_index == LEVEL_L11SUB1
        level11sub1_main()
    else if current_level_index == LEVEL_L12
        level12_main()
    else if current_level_index == LEVEL_L11SUB1LEFT1
        level11sub1left1_main()
    else if current_level_index == LEVEL_L11SUB2
        level11sub2_main()
    else if current_level_index == LEVEL_L11SUB3
        level11sub3_main()
    else if current_level_index == LEVEL_L11SUB3LEFT1
        level11sub3left1_main()
    else if current_level_index == LEVEL_GAME_OVER
        game_over_main()

fn level_draw_sprites(U o) U
    if current_level_index == LEVEL_L1
        o = draw_level1_sprites(o)
    else if current_level_index == LEVEL_L2
        o = draw_level2_sprites(o)
    else if current_level_index == LEVEL_L4
        o = draw_level4_sprites(o)
    else if current_level_index == LEVEL_L4SUB1
        o = draw_level4sub1_sprites(o)
    else if current_level_index == LEVEL_L6 || current_level_index == LEVEL_L6B
        o = draw_level6_sprites(o)
    else if current_level_index == LEVEL_L7
        o = draw_level7_sprites(o)
    else if current_level_index == LEVEL_L7OVER1
        o = draw_level7over1_sprites(o)
    else if current_level_index == LEVEL_L8
        o = draw_level8_sprites(o)
    else if current_level_index == LEVEL_L9
        o = draw_level9_sprites(o)
    else if current_level_index == LEVEL_L10
        o = draw_level10_sprites(o)
    else if current_level_index == LEVEL_L9SUB1
        o = draw_level9sub1_sprites(o)
    else if current_level_index == LEVEL_L9OVER1
        o = draw_level9over1_sprites(o)
    else if current_level_index == LEVEL_L9OVER2
        o = draw_level9over2_sprites(o)
    else if current_level_index == LEVEL_L10SUB1
        o = draw_level10sub1_sprites(o)
    else if current_level_index == LEVEL_L8OVER1
        o = draw_level8over1_sprites(o)
    else if current_level_index == LEVEL_L11
        o = draw_level11_sprites(o)
    else if current_level_index == LEVEL_L11SUB1
        o = draw_level11sub1_sprites(o)
    else if current_level_index == LEVEL_L12
        o = draw_level12_sprites(o)
    else if current_level_index == LEVEL_L11SUB1LEFT1
        o = draw_level11sub1left1_sprites(o)
    else if current_level_index == LEVEL_L11SUB2
        o = draw_level11sub2_sprites(o)
    else if current_level_index == LEVEL_L11SUB3
        o = draw_level11sub3_sprites(o)
    else if current_level_index == LEVEL_L11SUB3LEFT1
        o = draw_level11sub3left1_sprites(o)
    else if current_level_index == LEVEL_GAME_OVER
        o = game_over_sprites(o)
    
    o = draw_jails(o)
    o = draw_item_keys(o)

    // o = draw_item_bones(o) // Moved to main.fab for higher priority
    return o

fn respawn_all_enemies()
    for U i = 0; i < 22; i += 1
        dead_pilgrims[i] = 0
        dead_wheelbrokens[i] = 0
        dead_crucifieds[i] = 0
    
    // Disable NMI & rendering safely to prevent graphic corruption!
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)

    load_level(levels[current_level_index])
    load_level_finish()

    // Re-enable NMI & rendering!
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)

// Manually compile alternate Bank 25 for chr_2 (bg2.png + sprite2.png)
// Saves 16KB of ROM space by skipping alternate banks for chr_1 and font!
chrrom (25 * $2000)
    file(fmt, "../assets/bg2.png")
chrrom (25 * $2000 + $1000)
    file(fmt, "../assets/sprite2.png")