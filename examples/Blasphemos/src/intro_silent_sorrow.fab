// Opening Narrative Cutscene: The Silent Sorrow (awakening of the Penitent One)
// Plays between the Title Screen and Level 1.
// Uses the exact 11 screenshots provided by the user.

// We pack the 4 text cards (0, 1, 3, 5) into Bank 1 (utilizes deduplication to fit under 256 tiles!)
// We pack the remaining 7 artwork screens contiguously into Banks 2 to 5!
ct U[11] SORROW_PHYSICAL_BANKS = U[11](1, 1, 2, 1, 2, 1, 3, 3, 4, 4, 5)
ct U[11] SORROW_OFFSETS        = U[11](0, 0, 0, 0, 4, 0, 0, 4, 0, 4, 0)

// Bank 1: Widescreen Text Frames (0, 1, 3, 5 - heavily deduplicated!)
chrrom (1 * $2000)
    file(raw, "../assets/silent_sorrow_text.chr")

// Bank 2: Artwork 2 & 4
chrrom (2 * $2000)
    file(fmt, "../assets/silent_sorrow_2.png")
chrrom (2 * $2000 + $1000)
    file(fmt, "../assets/silent_sorrow_4.png")

// Bank 3: Artwork 6 & 7
chrrom (3 * $2000)
    file(fmt, "../assets/silent_sorrow_6.png")
chrrom (3 * $2000 + $1000)
    file(fmt, "../assets/silent_sorrow_7.png")

// Bank 4: Artwork 8 & 9
chrrom (4 * $2000)
    file(fmt, "../assets/silent_sorrow_8.png")
chrrom (4 * $2000 + $1000)
    file(fmt, "../assets/silent_sorrow_9.png")

// Bank 5: Artwork 10 & Sprite
chrrom (5 * $2000)
    file(fmt, "../assets/silent_sorrow_10.png")
chrrom (5 * $2000 + $1000)
    file(fmt, "../assets/sprite.png") // Align block 5 offset 4KB with standard sprites


fn sorrow_load_palette()
    {PPUSTATUS}()
    {PPUADDR}($3F)
    {PPUADDR}($00)
    // Palette 0: Black, Deep Crimson ($05), Cold Silver-Blue ($2C), White ($30)
    {PPUDATA}($0F)
    {PPUDATA}($05)
    {PPUDATA}($2C)
    {PPUDATA}($30)
    
    // Remaining palettes cleared to black
    for U i = 0; i < 28; i += 1
        {PPUDATA}($0F)

