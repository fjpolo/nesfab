    {PPUSTATUS}()
    {PPUADDR}($23)
    {PPUADDR}($C0)
    for U i = 0; i < 64; i += 1
        {PPUDATA}(0)

    if current_frame == 2
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_2_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_2_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_2_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_2_PART_3[i])
    else if current_frame == 4
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_4_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_4_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_4_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_4_PART_3[i])
    else if current_frame == 6
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_6_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_6_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_6_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_6_PART_3[i])
    else if current_frame == 7
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_7_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_7_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_7_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_7_PART_3[i])
    else if current_frame == 8
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_8_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_8_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_8_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_8_PART_3[i])
    else if current_frame == 9
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUADDR}($00)
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_9_PART_0[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_9_PART_1[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_9_PART_2[i])
        for U i = 0; i < 240; i += 1
            {PPUDATA}(SORROW_NAM_9_PART_3[i])
    else
        // 2. Map the 20x12 sequential/indexed tile window centered on the screen
        for U r = 9; r < 21; r += 1
            {PPUSTATUS}()
            UU addr = $2000 + (UU(r) << 5) + 6
            {PPUADDR}(addr.b)
            {PPUADDR}(addr.a)
            
            U row_offset = U((r - 9) * 20)
            for U c = 0; c < 20; c += 1
                U tile_index = 0
                U tile_pos = row_offset + c
                
                if current_frame == 0
                    tile_index = SORROW_NAM_0[tile_pos]
                else if current_frame == 1
                    tile_index = SORROW_NAM_1[tile_pos]
                else if current_frame == 3
                    tile_index = SORROW_NAM_3[tile_pos]
                else if current_frame == 5
                    tile_index = SORROW_NAM_5[tile_pos]
                else
                    tile_index = tile_pos
                    
                {PPUDATA}(tile_index)

// Custom frame selector function for packed slides
fn select_sorrow_frame(U X)
    U phys_bank = SORROW_PHYSICAL_BANKS[X]
    U offset = SORROW_OFFSETS[X]
    U base_2kb = (phys_bank << 3) + offset
    
    // Select background 4KB ($0000-$0FFF) using MMC3 2KB select registers
    mmc3_select(0, base_2kb)
    mmc3_select(1, base_2kb + 2)
    
    // Keep sprite banks safely set to standard level values to avoid corruption
    mmc3_select(2, 0)
    mmc3_select(3, 1)
    mmc3_select(4, 2)
    mmc3_select(5, 3)

mode play_intro_silent_sorrow()
: nmi game_nmi
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)

    // Slideshow durations (in NMI frames): 3s, 3s, 4s, 3s, 4s, 3s, 4s, 4s, 4s, 5s, 5s
    ct UU[11] SLIDE_DURATIONS = UU[11](180, 180, 240, 180, 240, 180, 240, 240, 240, 300, 300)
    
    is_start_pressed = false
    is_select_pressed = false
    palette_dirty = false // Stop NMI from overriding our custom palette

    for U current_frame = 0; current_frame < 11; current_frame += 1
        // Turn off rendering to update PPU smoothly between frames
        {PPUCTRL}(0)
        {PPUMASK}(0)

        // Select the CHR bank for the current slide
        select_sorrow_frame(current_frame)
        
        // Load palette and nametable
        sorrow_load_palette()
        sorrow_setup_nametable(current_frame)

        // Reset scroll and turn on rendering (BG only, no sprites)
        {PPUSTATUS}()
        {PPUADDR}($20)
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUADDR}($00)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_NT_2000)
        {PPUMASK}(PPUMASK_BG_ON | PPUMASK_NO_CLIP)

        // Wait for the slide duration
        UU slide_timer = 0
        UU duration = SLIDE_DURATIONS[current_frame]
        
        // Track whether the player skips the slideshow
        U skipped = 0
        
        while slide_timer < duration
            hide_oam(0) // Keep sprites fully hidden from any Title Screen remnants
            palette_dirty = false // Actively prevent NMI palette overrides
            nmi
            ppu_upload_oam_poll_pads(0)
            update_pads()

            // Check for skip input (START, A, or B buttons)
            if is_start_pressed || (pads[0].pressed & (BUTTON_A | BUTTON_B))
                is_start_pressed = false
                skipped = 1
                break
                
            slide_timer += 1
            
        if skipped != 0
            break

    // Fade out / disable rendering before loading Level 1
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    // Start Gameplay: Load Level 1
    game_state = GAME_STATE_PLAY
    current_level_index = FIRST_LEVEL_INDEX
    p.is_initialised = false
    goto mode play_level(current_level_index)
    : preserves /game
