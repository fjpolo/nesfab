    {PPUSTATUS}()
    {PPUADDR}($3F)
    {PPUADDR}($00)
    // Palette 0: Black, Deep Crimson ($05), Cold Silver-Blue ($2C), White ($30)
    {PPUDATA}($0F)
    {PPUDATA}($05)
    {PPUDATA}($2C)
    {PPUDATA}($30)
    
    // Remaining palettes cleared to black
    for U i = 0; i < 28; i += 1
        {PPUDATA}($0F)

