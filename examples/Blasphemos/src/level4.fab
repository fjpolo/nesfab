/*
 * BlasNESmous - Level 4
 * Prie Dieu Altar Logic
 */

fn level4_init()
    // Level 4 initialization logic here
    // SPR1 palette: ($2D, $17, $32)
    palette[15] = $2D
    palette[16] = $17
    palette[17] = $32
    ppu_upload_palette()

fn level4_main()
    // Altar hit detection
    // Adjusted: 4 pixels left (128 - 4 = 124)
    if current_level_index == LEVEL_L4 && p.movement == PLAYER_MOVING_ATTACK && !attack_has_hit
        if player_sword_x < 132 && (player_sword_x + player_sword_w) > 116
             attack_has_hit = true
             if !prie_dieu_lit || last_prie_dieu_level != LEVEL_L4
                 prie_dieu_lit = true
                 last_prie_dieu_level = current_level_index
                 last_prie_dieu_x = p.x
                 last_prie_dieu_y = SS(p.y)
                 log(@"Prie Dieu Level 4 lit!"l)
             
             p.health = U(PLAYER_MAX_HEALTH)
             p.current_bile_vessels = p.max_bile_vessels
             respawn_all_enemies()

fn draw_level4_sprites(U o) U
    if current_level_index == LEVEL_L4 && prie_dieu_lit && last_prie_dieu_level == LEVEL_L4
        SS ax = 124 - p.camera_x
        if ax > -16 && ax < 256
            // Draw candles using tiles $0E, $0F with palette 1 (SPR1)
            // Adjusted: 1 tile up (231 - 16 = 215)
            set_oam(o, U(ax - 4), 215, $0E, 1)
            o += 4
            set_oam(o, U(ax + 4), 215, $0F, 1)
            o += 4
    return o
