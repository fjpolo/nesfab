/*
 * BlasNESmous - Main
 * Based on LuciYFer engine
 */

audio(puf1_music, "../assets/blasphemous_music.txt")
audio(puf1_sfx)

// Button constants
ct Int SELECT_BUTTON_DEBOUNCE_FRAMES = 70
ct Int START_BUTTON_DEBOUNCE_FRAMES = 5

// Game states
ct Int GAME_STATE_TITLE = 1
ct Int GAME_STATE_PLAY = 2
ct Int GAME_STATE_WIN = 3
ct Int GAME_STATE_MAP = 4
ct Int GAME_STATE_DEAD_SCREEN = 5
ct Int GAME_STATE_MEA_CULPA_ALTAR = 6
ct Int GAME_STATE_GAME_OVER = 63

ct U GAME_MODE_NORMAL = 0
ct U GAME_MODE_KONAMI = 1

ct Int HUD_SCANLINE_IRQ = 14
ct Int CAMERA_CENTER_X = 128
ct Int CAMERA_RIGHT_LIMIT_OFFSET = 256
ct Int SPAWN_RIGHT_MARGIN = 48
ct Int SPAWN_LEFT_MARGIN = 16
ct Int LEVEL_EDGE_THRESHOLD = 8

ct Int CHEAT_SHAKE_LONG = 60
ct Int CHEAT_SHAKE_SHORT = 30
ct Int KONAMI_HP_NORMAL = 50
ct Int KONAMI_HP_CHEAT = 70

ct Int INVINCIBILITY_TEXT_POS_X = 72
ct Int INVINCIBILITY_TEXT_POS_Y = 80
ct Int INVINCIBILITY_TEXT_DURATION = 90

ct Int CHEAT_TIMEOUT_FRAMES = 120
ct Int TOTAL_LEVELS_COUNT = 22
ct Int MAP_TILE_HORIZONTAL = $2A
ct Int MAP_TILE_VERTICAL = $3A
ct Int MAP_TILE_PLAYER = $3E
ct U[14] INVINC_CHARS = U[14]($F8, $F9, $FA, $F8, $F9, $FB, $F8, $FC, $F8, $FD, $F8, $FE, $FF, $F2)

// Controller data
vars /controller
    Bool is_start_pressed = false
    U start_counter = 0
    Bool is_select_pressed = false
    U select_counter = 0
    
asm fn irq_enable()
: employs
    cli
    rts

// Game data
vars /game
    Player p = Player()
    U game_state = GAME_STATE_TITLE
    U frame_counter = 0
    Bool[NUMBER_OF_KEYS] keys
    Bool[NUMBER_OF_KEYS] show_key = Bool[NUMBER_OF_KEYS](true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true)
    U[NUMBER_OF_KEYS] key_x
    U[NUMBER_OF_KEYS] key_y
    Bool is_game_paused = false
    U prie_dieu_selected_option = 0
    U load_level_counter = 0
    U game_mode = GAME_MODE_NORMAL
    U cheat_index = 0
    U level_cheat_index = 0
    U cheat_timer = 0
    U cheat_shake_timer = 0
    Bool prie_dieu_lit = false
    U last_prie_dieu_level = 0
    SS last_prie_dieu_x = 0
    SS last_prie_dieu_y = 0
    Bool spawn_from_right = false
    Bool spawn_from_top = false
    Bool spawn_from_bottom = false
    U[60] dead_enemies = U[60](0)
    U[4] explored_rooms = U[4](0, 0, 0, 0)
    Bool warden_defeated = false
    Bool warden_arrow_dismissed = false
    Bool mea_culpa_upgraded = false
    U mea_culpa_level = 1
    U bile_vessel_hp = 18
    U fps_ticks = 0
    U fps_display = 60
    U fps_timer = 0
    U total_bones_collected = 0
    UU total_tears_collected = 0
    U invincibility_text_timer = 0
    Bool music_started = false

data /game
    [] konami_code
        U[10](BUTTON_UP, BUTTON_UP, BUTTON_DOWN, BUTTON_DOWN, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_LEFT, BUTTON_RIGHT, BUTTON_B, BUTTON_A)
    [] level_cheat_code
        U[4](BUTTON_B, BUTTON_A, BUTTON_B, BUTTON_A)

struct MapCoord
    U x
    U y
    Bool is_vertical

ct MapCoord[] level_map_coords = MapCoord[](
    MapCoord(0, 0, false),   // 0: Title
    MapCoord(5, 10, false),  // 1: Level 1
    MapCoord(6, 10, false),  // 2: Level 2a
    MapCoord(7, 10, false),  // 3: Level 2b
    MapCoord(8, 10, false),  // 4: Level 3a
    MapCoord(9, 10, false),  // 5: Level 3b
    MapCoord(10, 10, false), // 6: Level 4
    MapCoord(10, 11, true),  // 7: Level 4 Sub1
    MapCoord(11, 10, false), // 8: Level 5
    MapCoord(12, 10, false), // 9: Level 6a
    MapCoord(13, 10, false), // 10: Level 6b
    MapCoord(14, 10, false), // 11: Level 7
    MapCoord(14, 9, true),   // 12: Level 7over1
    MapCoord(15, 10, false), // 13: Level 8
    MapCoord(16, 10, false), // 14: Level 9
    MapCoord(17, 10, false), // 15: Level 10
    MapCoord(16, 11, true),  // 16: Level 9sub1
    MapCoord(16, 9, true),   // 17: Level 9over1
    MapCoord(16, 8, true),   // 18: Level 9over2
    MapCoord(17, 11, true),  // 19: Level 10sub1
    MapCoord(15, 9, true),   // 20: Level 8over1
    MapCoord(18, 10, false), // 21: Level 11
    MapCoord(18, 11, true),  // 22: Level 11sub1
    MapCoord(19, 10, false), // 23: Level 12
    MapCoord(17, 12, true),  // 24: Level 11sub1left1 (Avoiding 17, 11 overlap)
    MapCoord(0, 0, false),   // 25: Level 11sub2
    MapCoord(0, 0, false),   // 26: Level 11sub3
    MapCoord(0, 0, false),   // 27: Level 11sub3left1
    MapCoord(0, 0, false),   // 28: Level 13
    MapCoord(0, 0, false)    // 29: Game Over
)

// IRQ
irq game_irq()
    {MMC3_IRQ_DISABLE}(0) // Acknowledge and disable
    
    if game_state != GAME_STATE_PLAY
        return
    // Restore Level Bank for the gameplay area
    mmc3_select(0, current_level_chr << 3)
    mmc3_select(1, (current_level_chr << 3) + 2)

    // Set Level Scroll
    U shake_x = 0
    U shake_y = 0
    if (warden_active && warden_hurt_timer > 0) || cheat_shake_timer > 0
        shake_x = frame_counter & 3
        shake_y = (frame_counter >> 1) & 3
        
    {PPUSCROLL}(p.camera_x.a + shake_x)
    {PPUSCROLL}(shake_y)
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000 | (p.camera_x.b & 1))

// NMI
nmi game_nmi()
    frame_counter = frame_counter + 1
    fps_timer += 1
    if fps_timer >= 60
        fps_timer = 0
        fps_display = fps_ticks
        fps_ticks = 0


    ppu_upload_oam_poll_pads(0)

    if palette_dirty
        ppu_upload_palette()
        palette_dirty = false
        {PPUSTATUS}()

    // Update button counters before potential early return
    if pads[0].held & BUTTON_SELECT
        select_counter += 1
        if select_counter == SELECT_BUTTON_DEBOUNCE_FRAMES
            select_counter = 0
            is_select_pressed = true
    else
        select_counter = 0

    if pads[0].held & BUTTON_START
        start_counter += 1
        if start_counter == START_BUTTON_DEBOUNCE_FRAMES
            start_counter = 0
            is_start_pressed = true
    else
        start_counter = 0

    if current_level_index == LEVEL_GAME_OVER || game_state != GAME_STATE_PLAY
        if game_state != GAME_STATE_MEA_CULPA_ALTAR
            hide_oam(0) // Hide all sprites (in case HUD uses them)
        {MMC3_IRQ_DISABLE}(0)
        if game_state == GAME_STATE_GAME_OVER || game_state == GAME_STATE_MAP || game_state == GAME_STATE_WIN || game_state == GAME_STATE_MEA_CULPA_ALTAR
            if game_state == GAME_STATE_MEA_CULPA_ALTAR
                mmc3_select(0, 60) // Font BG (1KB banks 60-61, font.png first 2KB)
                mmc3_select(1, 62) // Font BG (1KB banks 62-63, font.png second 2KB)
            else
                mmc3_select(0, current_level_chr << 3)
                mmc3_select(1, (current_level_chr << 3) + 2)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
        puf.process(PUF_DEFAULT)
        return
    else
        // Set IRQ for scanline split (end of HUD split)
        mmc3_timer(HUD_SCANLINE_IRQ)

        // Set HUD Bank for the top of the screen
        mmc3_select(0, CHR_HUD << 3)
        mmc3_select(1, (CHR_HUD << 3) + 2)

        ppu_upload_scroll()
        update_hud_tiles() // Call after scroll upload to ensure priority
        
        // Reset scroll to (0,0) for the HUD split
        // PPUSTATUS resets the latch, then two PPUSCROLL writes set X and Y scroll.
        // Do NOT mix PPUADDR and PPUSCROLL writes — they share internal state.
        {PPUSTATUS}()
        {PPUSCROLL}(0)
        {PPUSCROLL}(0)
        {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000 | PPUCTRL_NT_2000)

        // Flash red when hurt, solid red when dead
        if warden_active && (warden_state == WARDEN_STATE_DEAD || (warden_hurt_timer > 0 && (frame_counter & 2)))
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP | $20) // Tint screen red
        else
            {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
        puf.process(PUF_DEFAULT)



// MAIN
mode main()  
    mmc3_reset()
    puf.init(system)
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)    
    game_state = GAME_STATE_TITLE
    goto mode play_intro_game_kitchen()
    : preserves /game

mode play_level(U level_index)
: nmi game_nmi
: irq game_irq
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    if !music_started
        puf.play_track(0)
        music_started = true

    load_level(levels[level_index])
    
    // Mark as explored
    explored_rooms[level_index >> 3] |= (U(1) << (level_index & 7))

    if !p.is_initialised
        p = make_player_penitent()
    
    if spawn_from_right
        p.x = (SS(current_level_width) << 4) - SPAWN_RIGHT_MARGIN
        p.camera_x = p.x - CAMERA_CENTER_X
        spawn_from_right = false
    if spawn_from_top || spawn_from_bottom
        p.camera_x = max(0, min(p.center_x - CAMERA_CENTER_X, (SS(current_level_width) << 4) - CAMERA_RIGHT_LIMIT_OFFSET))
        if spawn_from_top
            p.y = SSF(SPAWN_RIGHT_MARGIN) // Reusing 48 for top spawn
            spawn_from_top = false
        else
            p.y = SSF((SS(current_level_height) << 4) - SS(p.h) - 2)
            spawn_from_bottom = false

    p.camera_x = min(max(0, p.camera_x), (SS(current_level_width) << 4) - CAMERA_RIGHT_LIMIT_OFFSET)

    // Quick fix: force spawn position when entering Level 6
    if current_level_index == LEVEL_L6 && !spawn_from_right
        p.y = SSF(128)
        p.yspeed = 0

    load_level_finish()

    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    irq_enable()
    
    while true
        nmi
        fps_ticks += 1
        update_pads()
        check_pause()
        if IS_DEV_MODE
            export_hitboxes()
        if !is_game_paused
            update_player()
            level_update()
            check_cheats()
            update_sprites()
            update_scroll()

            if is_select_pressed
                is_select_pressed = false
                game_state = GAME_STATE_MAP
                goto mode map_screen(current_level_index)
                : preserves /game
        else
            update_pause_sprites()

ct Int HITBOX_EXPORT_ADDR = $4018

fn export_hitboxes()
    {HITBOX_EXPORT_ADDR}($77)
    {HITBOX_EXPORT_ADDR}($88)
    {HITBOX_EXPORT_ADDR}($99)
    {HITBOX_EXPORT_ADDR}($AA)

    {HITBOX_EXPORT_ADDR}(p.hitbox_x.a)
    {HITBOX_EXPORT_ADDR}(p.hitbox_x.b)
    
    SS py_int = SS(p.y)
    {HITBOX_EXPORT_ADDR}(py_int.a)
    {HITBOX_EXPORT_ADDR}(py_int.b)
    
    {HITBOX_EXPORT_ADDR}(p.w.a)
    {HITBOX_EXPORT_ADDR}(p.w.b)
    
    {HITBOX_EXPORT_ADDR}(p.h.a)
    {HITBOX_EXPORT_ADDR}(p.h.b)
    
    {HITBOX_EXPORT_ADDR}(warden_x.a)
    {HITBOX_EXPORT_ADDR}(warden_x.b)
    
    SS wy_int = SS(warden_y)
    {HITBOX_EXPORT_ADDR}(wy_int.a)
    {HITBOX_EXPORT_ADDR}(wy_int.b)
    
    {HITBOX_EXPORT_ADDR}(warden_w.a)
    {HITBOX_EXPORT_ADDR}(warden_w.b)
    
    {HITBOX_EXPORT_ADDR}(warden_h.a)
    {HITBOX_EXPORT_ADDR}(warden_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(warden_active))
    
    {HITBOX_EXPORT_ADDR}(p.camera_x.a)
    {HITBOX_EXPORT_ADDR}(p.camera_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_x.a)
    {HITBOX_EXPORT_ADDR}(player_sword_x.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_y.a)
    {HITBOX_EXPORT_ADDR}(player_sword_y.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_w.a)
    {HITBOX_EXPORT_ADDR}(player_sword_w.b)
    
    {HITBOX_EXPORT_ADDR}(player_sword_h.a)
    {HITBOX_EXPORT_ADDR}(player_sword_h.b)
    
    {HITBOX_EXPORT_ADDR}(U(player_sword_active))

    {HITBOX_EXPORT_ADDR}(warden_health)

    // Export Enraged Pilgrims (max 8)
    {HITBOX_EXPORT_ADDR}(enraged_pilgrims_num)
    for U i = 0; i < 8; i += 1
        if i < enraged_pilgrims_num
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].x.a)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].x.b)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].y.a)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].y.b)
            {HITBOX_EXPORT_ADDR}(enraged_pilgrims[i].health)
        else
            for U j = 0; j < 5; j += 1
                {HITBOX_EXPORT_ADDR}(0)

    // Export Wheelbrokens (max 8)
    {HITBOX_EXPORT_ADDR}(wheelbrokens_num)
    for U i = 0; i < 8; i += 1
        if i < wheelbrokens_num
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].x.a)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].x.b)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].y.a)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].y.b)
            {HITBOX_EXPORT_ADDR}(wheelbrokens[i].health)
        else
            for U j = 0; j < 5; j += 1
                {HITBOX_EXPORT_ADDR}(0)

    // Export Crucifieds (max 8)
    {HITBOX_EXPORT_ADDR}(crucifieds_num)
    for U i = 0; i < 8; i += 1
        if i < crucifieds_num
            {HITBOX_EXPORT_ADDR}(crucifieds[i].x.a)
            {HITBOX_EXPORT_ADDR}(crucifieds[i].x.b)
            {HITBOX_EXPORT_ADDR}(crucifieds[i].y.a)
            {HITBOX_EXPORT_ADDR}(crucifieds[i].y.b)
            {HITBOX_EXPORT_ADDR}(crucifieds[i].health)
        else
            for U j = 0; j < 5; j += 1
                {HITBOX_EXPORT_ADDR}(0)
    
    // Export Pinchos State & Pools
    {HITBOX_EXPORT_ADDR}(pinchos_state)
    
    // Normal Pinchos (max 9)
    {HITBOX_EXPORT_ADDR}(pinchos_num)
    for U i = 0; i < 9; i += 1
        if i < pinchos_num
            {HITBOX_EXPORT_ADDR}(pinchos[i].x.a)
            {HITBOX_EXPORT_ADDR}(pinchos[i].x.b)
            {HITBOX_EXPORT_ADDR}(pinchos[i].y.a)
            {HITBOX_EXPORT_ADDR}(pinchos[i].y.b)
        else
            for U j = 0; j < 4; j += 1
                {HITBOX_EXPORT_ADDR}(0)

    // Inverted Pinchos (max 1)
    {HITBOX_EXPORT_ADDR}(pinchos_invertidos_num)
    for U i = 0; i < 1; i += 1
        if i < pinchos_invertidos_num
            {HITBOX_EXPORT_ADDR}(pinchos_invertidos[i].x.a)
            {HITBOX_EXPORT_ADDR}(pinchos_invertidos[i].x.b)
            {HITBOX_EXPORT_ADDR}(pinchos_invertidos[i].y.a)
            {HITBOX_EXPORT_ADDR}(pinchos_invertidos[i].y.b)
        else
            for U j = 0; j < 4; j += 1
                {HITBOX_EXPORT_ADDR}(0)
    
    // Export Interactive Object Hitbox (Prie Dieu / Mea Culpa)
    {HITBOX_EXPORT_ADDR}(game_mode)
    U obj_type = 0
    if current_level_index == 24 || current_level_index == 2 || current_level_index == 6
        obj_type = 1 // Prie Dieu (24:L11SUB1LEFT1, 2:L2, 6:L4)
    else if current_level_index == 7
        obj_type = 2 // Mea Culpa (7:L4SUB1)
    {HITBOX_EXPORT_ADDR}(obj_type)
    
    // Bounds are hardcoded in player.fab as 90..160
    SS ox1 = 90
    SS ox2 = 160
    {HITBOX_EXPORT_ADDR}(ox1.a)
    {HITBOX_EXPORT_ADDR}(ox1.b)
    {HITBOX_EXPORT_ADDR}(ox2.a)
    {HITBOX_EXPORT_ADDR}(ox2.b)
    
    // Total bytes sent: 4 (Header) + 16 (P) + 11 (W) + 2 (Cam) + 17 (Sword) + 1 (WHP) + 1 (EP Num) + 40 (EP Data) + 1 (WB Num) + 40 (WB Data) + 1 (C Num) + 40 (C Data) + 1 (GM) + 1 (ObjT) + 4 (ObjBounds) = 180 bytes?
    // Wait! 
    // Header 4
    // Player: 2x 4 bytes = 8? No, x.a, x.b, py.a, py.b, w.a, w.b, h.a, h.b = 8 bytes.
    // Warden: 8 bytes. Active: 1 byte. Cam: 2 bytes. Sword: 9 bytes. WHP: 1 byte.
    // EP: 1 + 8*5 = 41. WB: 41. C: 41.
    // 4 + 8 + 8 + 1 + 2 + 9 + 1 + 41 + 41 + 41 = 157.
    // game_mode: 1. -> 158.
    // obj_type: 1. -> 159.
    // bounds: 4. -> 163.
    for U i = 0; i < 2; i += 1
        {HITBOX_EXPORT_ADDR}(0)

fn draw_enemies(U o) U
    U type_cycle = (frame_counter >> 3) & 3 // Rotate every 8 frames

    if type_cycle == 0
        o = draw_enraged_pilgrims(o)
        o = draw_wheelbrokens(o)
        o = draw_crucifieds(o)
        o = draw_pinchos(o)
    else if type_cycle == 1
        o = draw_wheelbrokens(o)
        o = draw_crucifieds(o)
        o = draw_enraged_pilgrims(o)
        o = draw_pinchos(o)
    else if type_cycle == 2
        o = draw_crucifieds(o)
        o = draw_enraged_pilgrims(o)
        o = draw_wheelbrokens(o)
        o = draw_pinchos(o)
    else
        o = draw_enraged_pilgrims(o)
        o = draw_crucifieds(o)
        o = draw_wheelbrokens(o)
        o = draw_pinchos(o)

    return o


fn draw_player_secondary(U o, SS draw_x, U attr_xor) U
    if p.hurt_timer == 0 || (frame_counter & 2) == 0
        o = push_oam_anim_palette(o, draw_x, SS(p.y) + p.h, p.anim_state, 1, attr_xor)
    return o

fn update_sprites()
    if current_level_index == LEVEL_GAME_OVER
        hide_oam(0)
        return
    U o = 0

    // Sprite 0 for HUD split (Must be at OAM index 0)
    // Placed at X=240, Y=14. Set to be behind background ($20) to hide it.
    // REMOVED: Scanline IRQ is now used instead.

    // Stage 1: Player Primary (Always Stable)
    U attr_xor = 0
    if p.heal_timer > 0
        attr_xor = 2
    
    // Calculate player draw X with facing correction (metasprite is -8..16)
    SS draw_x = p.x - p.camera_x + 8
    if p.facing_left
        draw_x += 8

    if p.hurt_timer == 0 || (frame_counter & 2) == 0
        o = push_oam_anim_palette(o, draw_x, SS(p.y) + p.h, p.anim_state, 0, attr_xor)

    // Stage 1.5: Items (High priority to avoid 64-sprite limit drops)
    o = draw_item_bones(o)

    // Stage 2: Rotating Priority (Flickering Group)
    U cycle = frame_counter & 7
    if cycle == 0
        o = draw_enemies(o)
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, draw_x, attr_xor)
    else if cycle == 1
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, draw_x, attr_xor)
        o = draw_enemies(o)
    else if cycle == 2
        o = draw_player_secondary(o, draw_x, attr_xor)
        o = draw_enemies(o)
        o = level_draw_sprites(o)
    else if cycle == 3
        o = level_draw_sprites(o)
        o = draw_enemies(o)
        o = draw_player_secondary(o, draw_x, attr_xor)
    else if cycle == 4
        o = draw_enemies(o)
        o = draw_player_secondary(o, draw_x, attr_xor)
        o = level_draw_sprites(o)
    else
        // Items and everything else
        o = draw_item_bones(o)
        o = draw_enemies(o)
        o = level_draw_sprites(o)
        o = draw_player_secondary(o, draw_x, attr_xor)



    // Draw player projectile
    if player_projectile_active
        if player_projectile_vx < 0
            o = push_oam_metasprite(o, player_projectile_x - p.camera_x, player_projectile_y, @sprite_player_projectile_left)
        else
            o = push_oam_metasprite(o, player_projectile_x - p.camera_x, player_projectile_y, @sprite_player_projectile_right)

    // Draw Lorquiana Prayer magic wave
    if prayer_active
        if prayer_vx < 0
            o = push_oam_metasprite(o, prayer_x - p.camera_x, prayer_y, @sprite_prayer_projectile_left)
        else
            o = push_oam_metasprite(o, prayer_x - p.camera_x, prayer_y, @sprite_prayer_projectile_right)

    // Draw Warden Defeated Arrow
    if warden_defeated && !warden_arrow_dismissed && current_level_index == LEVEL_L1 && (frame_counter & 16)
        set_oam(o, 240, 120, $3F, 0)
        o += 4

    // Tick down and draw invincibility text if active
    if invincibility_text_timer > 0
        invincibility_text_timer -= 1
        
        // 'I' -> $F8, 'N' -> $F9, 'V' -> $FA, 'C' -> $FB, 'B' -> $FC, 'L' -> $FD, 'T' -> $FE, 'Y' -> $FF, '!' -> $F2
        
        U cx = INVINCIBILITY_TEXT_POS_X
        U cy = INVINCIBILITY_TEXT_POS_Y // Center-aligned vertically
        for U i = 0; i < 14; i += 1
            set_oam(o, cx, cy, INVINC_CHARS[i], 2) // Attribute 2 selects sprite palette 2 (Red!)
            o += 4
            cx += 8

    hide_oam(o)

    // Tick animations
    if p.movement == PLAYER_MOVING_CLIMB && (pads[0].held & (BUTTON_UP | BUTTON_DOWN)) == 0
        // Pause climb animation when not moving
    else
        p.anim_state = tick_anim(p.anim_state, true)
    for U i = 0; i < enraged_pilgrims_num; i += 1
        enraged_pilgrim_anim_state[i] = tick_anim(enraged_pilgrim_anim_state[i], true)
    for U i = 0; i < wheelbrokens_num; i += 1
        wheelbroken_anim_state[i] = tick_anim(wheelbroken_anim_state[i], true)
    for U i = 0; i < crucifieds_num; i += 1
        crucified_anim_state[i] = tick_anim(crucified_anim_state[i], true)
    for U i = 0; i < item_bones_num; i += 1
        item_bone_anim_state[i] = tick_anim(item_bone_anim_state[i], true)

fn update_pause_sprites()
    {PPUMASK}(PPUMASK_GRAYSCALE | PPUMASK_ON | PPUMASK_NO_CLIP)

fn check_pause()
    if is_start_pressed 
        is_game_paused = !is_game_paused
        is_start_pressed = false

fn check_cheats()
    U pressed = pads[0].pressed
    if pressed != 0
        cheat_timer = 0
        
        // Konami Code
        CCC/game kcode = @konami_code
        if pressed == kcode[cheat_index]
            cheat_index += 1
            if cheat_index == 10
                cheat_index = 0
                cheat_shake_timer = CHEAT_SHAKE_LONG // Shake for 1 second
                if game_mode == GAME_MODE_NORMAL
                    game_mode = GAME_MODE_KONAMI
                    p.health = KONAMI_HP_NORMAL
                else
                    game_mode = GAME_MODE_NORMAL
                    p.health = KONAMI_HP_CHEAT
        else
            if pressed == kcode[0]
                cheat_index = 1
            else
                cheat_index = 0

        // Level Cheat (B A B A + Direction)
        CCC/game lcode = @level_cheat_code
        if level_cheat_index < 4
            if pressed == lcode[level_cheat_index]
                level_cheat_index += 1
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0
        else
            if pressed == BUTTON_RIGHT
                // Next level
                level_cheat_index = 0
                cheat_shake_timer = CHEAT_SHAKE_SHORT
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game

            else if pressed == BUTTON_LEFT
                // Previous level
                level_cheat_index = 0
                cheat_shake_timer = CHEAT_SHAKE_SHORT
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
            else
                if pressed == lcode[0]
                    level_cheat_index = 1
                else
                    level_cheat_index = 0

        // "Shift" shortcuts (SELECT + Left/Right/Start)
        if IS_DEV_MODE && (pads[0].held & BUTTON_SELECT)
            if pressed == BUTTON_START || pressed == BUTTON_RIGHT
                select_counter = 0 // Prevent map screen opening
                cheat_shake_timer = CHEAT_SHAKE_SHORT
                current_level_index += 1
                if current_level_index > LAST_LEVEL_INDEX
                    current_level_index = FIRST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                p.x = PLAYER_INITIAL_X
                p.y = SSF(PLAYER_INITIAL_Y)
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game

            else if pressed == BUTTON_LEFT
                select_counter = 0 // Prevent map screen opening
                cheat_shake_timer = 30
                if current_level_index > FIRST_LEVEL_INDEX
                    current_level_index -= 1
                else
                    current_level_index = LAST_LEVEL_INDEX
                
                p.level_index = current_level_index
                player_prepare_level_transition()
                spawn_from_right = true
                p.y = SSF(PLAYER_INITIAL_Y)
                p.camera_x = 0
                goto mode play_level(current_level_index)
                : preserves /game
    else
        cheat_timer += 1
        if cheat_timer > CHEAT_TIMEOUT_FRAMES
            cheat_index = 0
            level_cheat_index = 0
            cheat_timer = 0
    
    if cheat_shake_timer > 0
        cheat_shake_timer -= 1

// MAP SCREEN
mode map_screen(U previous_level)
: nmi game_nmi
    {PPUCTRL}(0)
    {PPUMASK}(0)
    hide_oam(0)
    
    // Save state so we can render the map properly at origin
    SS saved_camera = p.camera_x
    U saved_level_width = current_level_width  // load_level(@lev_map) will overwrite this
    p.camera_x = 0
    current_level_index = 255 // Dummy value to prevent level_init side effects
    
    // Clear HUD rows from nametables so they don't show artifacts
    clear_hud_rows()

    // Load the map level graphics, palettes, and metatiles using the mapfab level
    load_level(@lev_map)
    load_level_finish()

    // Ensure PPU is at 0,0 scroll before we start
    ppu_reset_scroll(0, 0)
    {PPUCTRL}(PPUCTRL_NMI_ON | PPUCTRL_SPR_PT_1000)
    {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)

    while true
        nmi
        
        U o = 0
        
        // Draw Explored Room Markers
        for U i = 0; i < TOTAL_LEVELS_COUNT; i += 1
            if (explored_rooms[i >> 3] & (U(1) << (i & 7))) != 0
                MapCoord rc = level_map_coords[i]
                if rc.x != 0 || rc.y != 0 // Don't draw title screen/invalid coords
                    U tile = MAP_TILE_HORIZONTAL
                    if rc.is_vertical
                        tile = MAP_TILE_VERTICAL
                    set_oam(o, rc.x << 3, (rc.y + 1) << 3, tile, 0)
                    o += 4

        // Draw Player Marker over the map
        MapCoord pc = level_map_coords[previous_level]
        if (frame_counter & 16) != 0 // Flash every 16 frames
            // Horizontal: 1/32 scale (8px per screen)
            // Vertical: 1/16 scale (16px per screen)
            // Sub-room pixel offset: normalize p.x by the GAMEPLAY level's pixel width
            // (saved before load_level(@lev_map) overwrote current_level_width).
            // saved_level_width cols × 16px/col = total pixel span. Scale to 0..7 map pixels.
            U divisor = saved_level_width << 1
            U sub_x_int = 0
            SS temp_x = p.x
            while temp_x >= SS(divisor)
                temp_x -= SS(divisor)
                sub_x_int += 1
            SS sub_x = SS(sub_x_int)
            SS map_px = (SS(pc.x) << 3) + sub_x
            SS map_py = ((SS(pc.y) + 1) << 3) + (SS(p.y) >> 4) - 11
            set_oam(o, map_px.a, map_py.a, MAP_TILE_PLAYER, 1) // Using Palette 1
            o += 4
        
        hide_oam(o)
        
        ppu_upload_oam_poll_pads(0)
        update_pads()
        
        if is_select_pressed || is_start_pressed
            is_select_pressed = false
            is_start_pressed = false
            
            // Restore state
            current_level_index = previous_level
            p.camera_x = saved_camera
            
            game_state = GAME_STATE_PLAY
            goto mode play_level(previous_level)
            : preserves /game


