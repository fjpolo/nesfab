#:name:# 
#:chr_name:# 
#:palette_name:# 
#:metatiles_name:# 

data /levels
    [] lev_#name#
        U(chr_#chr_name#_index) // The CHR bank
        (@pal_#palette_name#)   // Pointer to the palette
        (@mt_#metatiles_name#)  // Pointer to the metatiles
        U(_width)               // The width, in tiles.
        U(_height)              // The height, in tiles.
        (@tiles_#name#)         // Pointer to the level tiles
        U(_enraged_pilgrim_num)         // Number of "enraged_pilgrim" objects
        (enraged_pilgrims_vec(_enraged_pilgrim_x, _enraged_pilgrim_y))
        U(_crucified_num)               // Number of "crucified" objects
        (crucifieds_vec(_crucified_x, _crucified_y))
        U(_wheelbroken_num)                // Number of "wheelbroken" objects
        (wheelbroken_vec(_wheelbroken_x, _wheelbroken_y))
        U(_item_bone_num)                 // Number of "item_bone" objects
        (item_bones_vec(_item_bone_x, _item_bone_y))


    [] tiles_#name#
            (_column_major)